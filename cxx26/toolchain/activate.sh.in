#!/usr/bin/env bash
# Source this file; do not execute it.

if [[ -n "${BASH_VERSION:-}" ]]; then
  _cxx26_source="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  _cxx26_source="${(%):-%x}"
else
  echo "clang-cxx26 activation currently supports Bash and zsh." >&2
  return 1 2>/dev/null || exit 1
fi

_cxx26_root="$(
  cd -- "$(dirname -- "${_cxx26_source}")/../.." >/dev/null 2>&1
  pwd -P
)"

export CXX26_TOOLCHAIN_ROOT="${_cxx26_root}"
export CXX26_CMAKE_TOOLCHAIN_FILE="${_cxx26_root}/share/clang-cxx26/toolchain.cmake"

export CC="${_cxx26_root}/bin/clang"
export CXX="${_cxx26_root}/bin/clang++"
export PATH="${_cxx26_root}/bin:${PATH}"

_cxx26_library_path="@CXX26_LIBRARY_PATH@"
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
  export LD_LIBRARY_PATH="${_cxx26_library_path}:${LD_LIBRARY_PATH}"
else
  export LD_LIBRARY_PATH="${_cxx26_library_path}"
fi

unset _cxx26_library_path
unset _cxx26_root
unset _cxx26_source
