# Generated as part of an immutable clang-cxx26 reference-toolchain snapshot.
# This file is relocatable with the snapshot directory.

cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH _cxx26_share_dir)
cmake_path(GET _cxx26_share_dir PARENT_PATH _cxx26_root)
cmake_path(NORMAL_PATH _cxx26_root)

set(CMAKE_C_COMPILER
    "${_cxx26_root}/bin/clang"
    CACHE FILEPATH "clang-cxx26 C compiler")
set(CMAKE_CXX_COMPILER
    "${_cxx26_root}/bin/clang++"
    CACHE FILEPATH "clang-cxx26 C++ compiler")

# vcpkg sets CMAKE_SYSTEM_NAME when it invokes a chainloaded toolchain. That
# makes CMake require a target processor as well; leave an explicitly provided
# cross target intact, but describe this Linux x86_64 snapshot otherwise.
if(NOT DEFINED CMAKE_SYSTEM_PROCESSOR OR CMAKE_SYSTEM_PROCESSOR STREQUAL "")
  set(CMAKE_SYSTEM_PROCESSOR x86_64 CACHE STRING "clang-cxx26 target processor" FORCE)
endif()

if(EXISTS "${_cxx26_root}/bin/llvm-ar")
  set(CMAKE_AR
      "${_cxx26_root}/bin/llvm-ar"
      CACHE FILEPATH "clang-cxx26 archiver")
endif()

if(EXISTS "${_cxx26_root}/bin/llvm-ranlib")
  set(CMAKE_RANLIB
      "${_cxx26_root}/bin/llvm-ranlib"
      CACHE FILEPATH "clang-cxx26 ranlib")
endif()

# A reference snapshot models the fork's complete C++26 mode. Keep the
# language mode explicit at the toolchain boundary so CMake's synthetic
# standard-library module target is compiled with the same mode as consumers.
# Linux Clang otherwise defaults to libstdc++, and the current cxx26 fork still
# gates the complete reflection implementation behind -freflection-latest.
#
# -Wno-reserved-module-identifier belongs here too, not on the
# std.cppm/std.compat.cppm sources directly: CMake's synthetic import-std
# target (CXX_MODULE_STD) does not go through a normal target_sources() path,
# so set_source_files_properties(... COMPILE_OPTIONS ...) on those files is
# silently a no-op for it -- confirmed by inspecting the actual generated
# compile command, which carries none of a per-source COMPILE_OPTIONS
# addition, only these global _INIT flags. It also does not inherit a
# consumer's own target-level warning flags (e.g. -Wall/-Werror), so the
# warning both packaged interface units unavoidably trigger --
# `export module std;`/`export module std.compat;` naming a reserved
# identifier, entirely expected for the standard library's own module
# sources -- would otherwise appear in every consumer that enables
# CXX_MODULE_STD, with no consumer-side way to suppress it (a source-level
# fix isn't consumer-editable; these paths point into the installed
# toolchain, not the consumer's own tree).
#
# CMake may evaluate a toolchain file more than once while enabling languages.
# Append each flag only when it is not already present so repeated evaluation
# cannot duplicate the reference-mode command line.
foreach(_cxx26_cxx_flag IN ITEMS -std=c++26 -stdlib=libc++ -freflection-latest -fcontracts -Wno-reserved-module-identifier)
  string(FIND " ${CMAKE_CXX_FLAGS_INIT} " " ${_cxx26_cxx_flag} "
              _cxx26_flag_index)
  if(_cxx26_flag_index EQUAL -1)
    string(APPEND CMAKE_CXX_FLAGS_INIT " ${_cxx26_cxx_flag}")
  endif()
endforeach()

# Contracts (P2900R14) are enabled by default (-fcontracts above), but their
# evaluation semantic is deliberately per-config: `enforce` where a developer
# is debugging (violations abort, same posture as assert()/NDEBUG), `ignore`
# in Release/MinSizeRel so the reference toolchain has zero contract-checking
# cost in an optimized build unless a consumer explicitly opts in. A consumer
# project can still override this by setting its own
# -fcontract-evaluation-semantic= before this toolchain file runs, since the
# same append-if-absent idiom above governs this loop too.
foreach(_cxx26_contract_config_flag IN ITEMS
        "CMAKE_CXX_FLAGS_DEBUG_INIT:-fcontract-evaluation-semantic=enforce"
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO_INIT:-fcontract-evaluation-semantic=enforce"
        "CMAKE_CXX_FLAGS_RELEASE_INIT:-fcontract-evaluation-semantic=ignore"
        "CMAKE_CXX_FLAGS_MINSIZEREL_INIT:-fcontract-evaluation-semantic=ignore")
  string(REPLACE ":" ";" _cxx26_contract_config_pair "${_cxx26_contract_config_flag}")
  list(GET _cxx26_contract_config_pair 0 _cxx26_contract_config_var)
  list(GET _cxx26_contract_config_pair 1 _cxx26_contract_config_value)
  string(FIND " ${${_cxx26_contract_config_var}} " " ${_cxx26_contract_config_value} "
              _cxx26_flag_index)
  if(_cxx26_flag_index EQUAL -1)
    string(APPEND ${_cxx26_contract_config_var} " ${_cxx26_contract_config_value}")
  endif()
endforeach()

# CMake's Ninja/Makefiles generators reuse CMAKE_CXX_FLAGS(_<CONFIG>) verbatim
# as part of the final link command, since clang++ drives both compiling and
# linking -- so every compile-only flag added above (-fcontracts,
# -fcontract-evaluation-semantic=, etc.) legitimately, harmlessly, and
# unavoidably triggers -Wunused-command-line-argument at link time. This is
# not a bug in those flags or in this file; suppress the resulting noise here
# rather than expecting a consumer to notice and add it themselves.
foreach(_cxx26_linker_flags_var IN ITEMS CMAKE_EXE_LINKER_FLAGS_INIT
                                          CMAKE_SHARED_LINKER_FLAGS_INIT
                                          CMAKE_MODULE_LINKER_FLAGS_INIT)
  string(FIND " ${${_cxx26_linker_flags_var}} " " -fuse-ld=lld "
              _cxx26_flag_index)
  if(_cxx26_flag_index EQUAL -1)
    string(APPEND ${_cxx26_linker_flags_var} " -fuse-ld=lld")
  endif()
  string(FIND " ${${_cxx26_linker_flags_var}} " " -Wno-unused-command-line-argument "
              _cxx26_flag_index)
  if(_cxx26_flag_index EQUAL -1)
    string(APPEND ${_cxx26_linker_flags_var} " -Wno-unused-command-line-argument")
  endif()
endforeach()

set(CMAKE_BUILD_RPATH "@CXX26_BUILD_RPATH@")

# CMake 4.4 still requires the experimental import-std gate to be enabled before
# C++ language discovery. A project may also set this itself.
if(CMAKE_VERSION VERSION_LESS 4.5 AND NOT DEFINED
                                      CMAKE_EXPERIMENTAL_CXX_IMPORT_STD)
  set(CMAKE_EXPERIMENTAL_CXX_IMPORT_STD
      "f35a9ac6-8463-4d38-8eec-5d6008153e7d"
      CACHE STRING "CMake 4.4 import-std experimental gate")
endif()

unset(_cxx26_flag_index)
unset(_cxx26_linker_flags_var)
unset(_cxx26_cxx_flag)
unset(_cxx26_share_dir)
unset(_cxx26_root)
