index 0000000000000..cfb043b3ad409
--- /dev/null
+++ b/libcxx/test/std/experimental/reflection/description-of-template-kinds.verify.cpp
@@ -0,0 +1,43 @@
+//===----------------------------------------------------------------------===//
+//
