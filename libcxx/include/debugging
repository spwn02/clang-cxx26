#ifndef _LIBCPP_DEBUGGING
#define _LIBCPP_DEBUGGING

#if __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
#  include <__cxx03/__config>
#else
#  include <__config>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

#if _LIBCPP_STD_VER >= 26

#  include <__debugging/is_debugger_present.h>

_LIBCPP_BEGIN_NAMESPACE_STD

_LIBCPP_HIDE_FROM_ABI inline void breakpoint() noexcept {
#  if __has_builtin(__builtin_debugtrap)
  __builtin_debugtrap();
#  else
  __builtin_trap();
#  endif
}

_LIBCPP_HIDE_FROM_ABI inline void breakpoint_if_debugging() noexcept {
  if (is_debugger_present())
    breakpoint();
}

_LIBCPP_END_NAMESPACE_STD

#endif // _LIBCPP_STD_VER >= 26

// P2758: emitting messages at compile time (C++29).
#if _LIBCPP_STD_VER >= 29 && __has_builtin(__builtin_constexpr_diag)

#  include <string_view>
#  include <type_traits>

_LIBCPP_BEGIN_NAMESPACE_STD

// The exposition-only tag-string: a compile-time string restricted to
// characters that are safe to expose as a diagnostic control (letters,
// digits, '_', '-', '=').
struct __tag_string {
  string_view __str_;

  template <class _Tp>
    requires is_convertible_v<const _Tp&, string_view>
  _LIBCPP_HIDE_FROM_ABI consteval __tag_string(const _Tp& __s) : __str_(__s) {
    for (char __c : __str_) {
      const bool __ok = (__c >= 'a' && __c <= 'z') || (__c >= 'A' && __c <= 'Z') || (__c >= '0' && __c <= '9') ||
                        __c == '_' || __c == '-' || __c == '=';
      if (__ok)
        continue;
      // The builtin rejects the malformed tag, so this consteval
      // constructor is not a constant expression -- diagnosed here, at the
      // construction of the tag, rather than at its eventual use.
      __builtin_constexpr_diag(2, __str_.data(), __str_.size(), "", 0);
      break;
    }
  }
};

_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_print_str(string_view __msg) noexcept {
  __builtin_constexpr_diag(0, "", 0, __msg.data(), __msg.size());
}
_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_print_str(u8string_view __msg) noexcept {
  __builtin_constexpr_diag(0, "", 0, __msg.data(), __msg.size());
}
_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_print_str(__tag_string __tag,
                                          string_view __msg) noexcept {
  __builtin_constexpr_diag(0, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}
_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_print_str(__tag_string __tag,
                                          u8string_view __msg) noexcept {
  __builtin_constexpr_diag(0, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}

_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_warning_str(__tag_string __tag,
                                            string_view __msg) noexcept {
  __builtin_constexpr_diag(1, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}
_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_warning_str(__tag_string __tag,
                                            u8string_view __msg) noexcept {
  __builtin_constexpr_diag(1, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}

_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_error_str(__tag_string __tag,
                                          string_view __msg) noexcept {
  __builtin_constexpr_diag(2, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}
_LIBCPP_HIDE_FROM_ABI inline constexpr void constexpr_error_str(__tag_string __tag,
                                          u8string_view __msg) noexcept {
  __builtin_constexpr_diag(2, __tag.__str_.data(), __tag.__str_.size(),
                           __msg.data(), __msg.size());
}

_LIBCPP_END_NAMESPACE_STD

#endif // _LIBCPP_STD_VER >= 29 && __has_builtin(__builtin_constexpr_diag)

#endif // __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)

#endif // _LIBCPP_DEBUGGING
