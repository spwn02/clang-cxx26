#  pragma GCC system_header
#endif

_LIBCPP_PUSH_MACROS
#include <__undef_macros>

_LIBCPP_BEGIN_NAMESPACE_STD

// Storage for inplace_vector<T, N>. When T is trivially default-constructible
// and trivially destructible, a plain array is used: this keeps the whole
// container usable in constant expressions, since forming pointers into it
// never requires a reinterpret_cast (banned in constant evaluation). For
// other T, we fall back to raw bytes activated via placement-new; this path
// works at runtime but, because of the reinterpret_cast in __get(), cannot
// be constant-evaluated -- there is no portable way to get a real contiguous
// T* into lazily-activated storage inside a constant expression without
// giving up the "no dynamic allocation" property that makes inplace_vector
// worth having in the first place.
template <class _Tp, size_t _Cap, bool = is_trivially_default_constructible_v<_Tp> && is_trivially_destructible_v<_Tp>>
struct __inplace_vector_storage {
  alignas(_Tp) unsigned char __data_[_Cap == 0 ? 1 : _Cap * sizeof(_Tp)];

  _LIBCPP_HIDE_FROM_ABI constexpr auto __get() noexcept -> _Tp* {
    return std::launder(reinterpret_cast<_Tp*>(__data_));
  }
  _LIBCPP_HIDE_FROM_ABI constexpr auto __get() const noexcept -> const _Tp* {
    return std::launder(reinterpret_cast<const _Tp*>(__data_));
  }
};

template <class _Tp, size_t _Cap>
struct __inplace_vector_storage<_Tp, _Cap, true> {
  _Tp __data_[_Cap == 0 ? 1 : _Cap]{};

  _LIBCPP_HIDE_FROM_ABI constexpr auto __get() noexcept -> _Tp* { return __data_; }
  _LIBCPP_HIDE_FROM_ABI constexpr auto __get() const noexcept -> const _Tp* { return __data_; }
};

template <class _Tp, size_t Capacity>
class inplace_vector {
public:
  using value_type             = _Tp;
  using size_type               = size_t;
  using difference_type         = ptrdiff_t;
  using reference               = value_type&;
  using const_reference         = const value_type&;
  using pointer                 = value_type*;
  using const_pointer           = const value_type*;
  using iterator                = value_type*;
  using const_iterator          = const value_type*;
  using reverse_iterator        = std::reverse_iterator<iterator>;
  using const_reverse_iterator  = std::reverse_iterator<const_iterator>;

  constexpr inplace_vector() noexcept = default;

  constexpr explicit inplace_vector(size_type __n) { __append_default(__n); }

  constexpr inplace_vector(size_type __n, const _Tp& __value) { __append_fill(__n, __value); }

  template <class InputIt, class = decltype(*std::declval<InputIt&>(), void())>
  constexpr inplace_vector(InputIt __first, InputIt __last) {
    for (; __first != __last; ++__first)
      emplace_back(*__first);
  }

  constexpr inplace_vector(std::initializer_list<_Tp> __il)
      : inplace_vector(__il.begin(), __il.end()) {}

  constexpr inplace_vector(const inplace_vector& __other) { __append_copy(__other); }

  constexpr inplace_vector(inplace_vector&& __other) noexcept(is_nothrow_move_constructible_v<_Tp>) {
    __append_move(__other);
  }

  constexpr ~inplace_vector() { clear(); }

  constexpr auto operator=(const inplace_vector& __other) -> inplace_vector& {
    if (this != std::addressof(__other))
      assign(__other.begin(), __other.end());
    return *this;
  }

  constexpr auto operator=(inplace_vector&& __other) noexcept(
      is_nothrow_move_constructible_v<_Tp> && is_nothrow_move_assignable_v<_Tp>) -> inplace_vector& {
    if (this == std::addressof(__other))
      return *this;
    clear();
    __append_move(__other);
    return *this;
  }

  constexpr auto operator=(std::initializer_list<_Tp> __il) -> inplace_vector& {
    assign(__il.begin(), __il.end());
    return *this;
  }

  template <class InputIt, class = decltype(*std::declval<InputIt&>(), void())>
  constexpr void assign(InputIt __first, InputIt __last) {
    clear();
    for (; __first != __last; ++__first)
      emplace_back(*__first);
  }

  constexpr void assign(size_type __n, const _Tp& __value) {
    clear();
    __append_fill(__n, __value);
  }

  constexpr void assign(std::initializer_list<_Tp> __il) { assign(__il.begin(), __il.end()); }

  // element access

  [[nodiscard]] constexpr auto at(size_type __i) -> reference {
    if (__i >= size_)
      std::__throw_out_of_range("inplace_vector::at");
    return data()[__i];
  }
  [[nodiscard]] constexpr auto at(size_type __i) const -> const_reference {
    if (__i >= size_)
      std::__throw_out_of_range("inplace_vector::at");
    return data()[__i];
  }

  [[nodiscard]] constexpr auto operator[](size_type __i) -> reference { return data()[__i]; }
  [[nodiscard]] constexpr auto operator[](size_type __i) const -> const_reference { return data()[__i]; }

  [[nodiscard]] constexpr auto front() -> reference { return data()[0]; }
  [[nodiscard]] constexpr auto front() const -> const_reference { return data()[0]; }
  [[nodiscard]] constexpr auto back() -> reference { return data()[size_ - 1]; }
  [[nodiscard]] constexpr auto back() const -> const_reference { return data()[size_ - 1]; }

  [[nodiscard]] constexpr auto data() noexcept -> _Tp* { return storage_.__get(); }
  [[nodiscard]] constexpr auto data() const noexcept -> const _Tp* { return storage_.__get(); }

  // iterators

  [[nodiscard]] constexpr auto begin() noexcept -> iterator { return data(); }
  [[nodiscard]] constexpr auto end() noexcept -> iterator { return data() + size_; }
  [[nodiscard]] constexpr auto begin() const noexcept -> const_iterator { return data(); }
  [[nodiscard]] constexpr auto end() const noexcept -> const_iterator { return data() + size_; }
  [[nodiscard]] constexpr auto cbegin() const noexcept -> const_iterator { return data(); }
  [[nodiscard]] constexpr auto cend() const noexcept -> const_iterator { return data() + size_; }

  [[nodiscard]] constexpr auto rbegin() noexcept -> reverse_iterator { return reverse_iterator(end()); }
  [[nodiscard]] constexpr auto rend() noexcept -> reverse_iterator { return reverse_iterator(begin()); }
  [[nodiscard]] constexpr auto rbegin() const noexcept -> const_reverse_iterator {
    return const_reverse_iterator(end());
  }
  [[nodiscard]] constexpr auto rend() const noexcept -> const_reverse_iterator {
    return const_reverse_iterator(begin());
  }
  [[nodiscard]] constexpr auto crbegin() const noexcept -> const_reverse_iterator { return rbegin(); }
  [[nodiscard]] constexpr auto crend() const noexcept -> const_reverse_iterator { return rend(); }

  // capacity

  [[nodiscard]] constexpr auto empty() const noexcept -> bool { return size_ == 0; }
  [[nodiscard]] constexpr auto size() const noexcept -> size_type { return size_; }
  [[nodiscard]] static constexpr auto max_size() noexcept -> size_type { return Capacity; }
  [[nodiscard]] static constexpr auto capacity() noexcept -> size_type { return Capacity; }

  constexpr void resize(size_type __sz) {
    if (__sz > Capacity)
      std::__throw_bad_alloc();
    if (__sz < size_) {
      while (size_ > __sz)
        pop_back();
    } else {
      __append_default(__sz - size_);
    }
  }

  constexpr void resize(size_type __sz, const _Tp& __value) {
    if (__sz > Capacity)
      std::__throw_bad_alloc();
    if (__sz < size_) {
      while (size_ > __sz)
        pop_back();
    } else {
      __append_fill(__sz - size_, __value);
    }
  }

  constexpr void reserve(size_type __n) {
    if (__n > Capacity)
      std::__throw_bad_alloc();
  }

  constexpr void shrink_to_fit() noexcept {}

  // modifiers

  constexpr auto try_push_back(const _Tp& __value) -> pointer {
    if (size_ >= Capacity)
      return nullptr;
    std::construct_at(data() + size_, __value);
    return data() + size_++;
  }

  constexpr auto try_push_back(_Tp&& __value) -> pointer {
    if (size_ >= Capacity)
      return nullptr;
    std::construct_at(data() + size_, std::move(__value));
    return data() + size_++;
  }

  template <class... _Args>
  constexpr auto try_emplace_back(_Args&&... __args) -> pointer {
    if (size_ >= Capacity)
      return nullptr;
    std::construct_at(data() + size_, std::forward<_Args>(__args)...);
    return data() + size_++;
  }

  constexpr auto push_back(const _Tp& __value) -> reference {
    auto* __p = try_push_back(__value);
    if (__p == nullptr)
      std::__throw_bad_alloc();
    return *__p;
  }

  constexpr auto push_back(_Tp&& __value) -> reference {
    auto* __p = try_push_back(std::move(__value));
    if (__p == nullptr)
      std::__throw_bad_alloc();
    return *__p;
  }

  template <class... _Args>
  constexpr auto emplace_back(_Args&&... __args) -> reference {
    auto* __p = try_emplace_back(std::forward<_Args>(__args)...);
    if (__p == nullptr)
      std::__throw_bad_alloc();
    return *__p;
  }

  constexpr auto unchecked_push_back(const _Tp& __value) -> reference {
    std::construct_at(data() + size_, __value);
    return data()[size_++];
  }

  constexpr auto unchecked_push_back(_Tp&& __value) -> reference {
    std::construct_at(data() + size_, std::move(__value));
    return data()[size_++];
  }

  template <class... _Args>
  constexpr auto unchecked_emplace_back(_Args&&... __args) -> reference {
    std::construct_at(data() + size_, std::forward<_Args>(__args)...);
    return data()[size_++];
  }

  constexpr void pop_back() {
    --size_;
    std::destroy_at(data() + size_);
  }

  constexpr auto insert(const_iterator __pos, const _Tp& __value) -> iterator { return emplace(__pos, __value); }
  constexpr auto insert(const_iterator __pos, _Tp&& __value) -> iterator { return emplace(__pos, std::move(__value)); }

  constexpr auto insert(const_iterator __pos, size_type __n, const _Tp& __value) -> iterator {
    size_type __idx = static_cast<size_type>(__pos - cbegin());
    if (size_ + __n > Capacity)
      std::__throw_bad_alloc();
    for (size_type __i = 0; __i < __n; ++__i)
      unchecked_push_back(__value);
    std::rotate(data() + __idx, data() + size_ - __n, data() + size_);
    return data() + __idx;
  }

  template <class InputIt, class = decltype(*std::declval<InputIt&>(), void())>
  constexpr auto insert(const_iterator __pos, InputIt __first, InputIt __last) -> iterator {
    size_type __idx = static_cast<size_type>(__pos - cbegin());
    size_type __old_size = size_;
    for (; __first != __last; ++__first)
      emplace_back(*__first);
    std::rotate(data() + __idx, data() + __old_size, data() + size_);
    return data() + __idx;
  }

  constexpr auto insert(const_iterator __pos, std::initializer_list<_Tp> __il) -> iterator {
    return insert(__pos, __il.begin(), __il.end());
  }

  template <class... _Args>
  constexpr auto emplace(const_iterator __pos, _Args&&... __args) -> iterator {
    size_type __idx = static_cast<size_type>(__pos - cbegin());
    if (size_ >= Capacity)
      std::__throw_bad_alloc();
    if (__idx == size_) {
      unchecked_emplace_back(std::forward<_Args>(__args)...);
      return data() + __idx;
    }
    unchecked_push_back(std::move(data()[size_ - 1]));
    for (size_type __i = size_ - 1; __i > __idx; --__i)
      data()[__i] = std::move(data()[__i - 1]);
    data()[__idx] = _Tp(std::forward<_Args>(__args)...);
    return data() + __idx;
  }

  constexpr auto erase(const_iterator __pos) -> iterator {
    size_type __idx = static_cast<size_type>(__pos - cbegin());
    for (size_type __i = __idx; __i + 1 < size_; ++__i)
      data()[__i] = std::move(data()[__i + 1]);
    pop_back();
    return data() + __idx;
  }

  constexpr auto erase(const_iterator __first, const_iterator __last) -> iterator {
    size_type __idx = static_cast<size_type>(__first - cbegin());
    size_type __n   = static_cast<size_type>(__last - __first);
    for (size_type __i = __idx; __i + __n < size_; ++__i)
      data()[__i] = std::move(data()[__i + __n]);
    for (size_type __i = 0; __i < __n; ++__i)
      pop_back();
    return data() + __idx;
  }

  constexpr void clear() noexcept {
    while (size_ != 0)
      pop_back();
  }

  constexpr void swap(inplace_vector& __other) noexcept(
      is_nothrow_swappable_v<_Tp> && is_nothrow_move_constructible_v<_Tp>) {
    size_type __this_original  = size_;
    size_type __other_original = __other.size_;
    size_type __common         = std::min(size_, __other.size_);
    for (size_type __i = 0; __i < __common; ++__i) {
      using std::swap;
      swap(data()[__i], __other.data()[__i]);
    }
    if (size_ > __other.size_) {
      for (size_type __i = __common; __i < size_; ++__i) {
        __other.unchecked_push_back(std::move(data()[__i]));
        std::destroy_at(data() + __i);
      }
    } else if (__other.size_ > size_) {
      for (size_type __i = __common; __i < __other.size_; ++__i) {
        unchecked_push_back(std::move(__other.data()[__i]));
        std::destroy_at(__other.data() + __i);
      }
    }
    size_        = __other_original;
    __other.size_ = __this_original;
  }

  friend constexpr void swap(inplace_vector& __x, inplace_vector& __y) noexcept(noexcept(__x.swap(__y))) {
    __x.swap(__y);
  }

  [[nodiscard]] friend constexpr auto operator==(const inplace_vector& __x, const inplace_vector& __y) -> bool {
    return std::equal(__x.begin(), __x.end(), __y.begin(), __y.end());
  }

  [[nodiscard]] friend constexpr auto operator<=>(const inplace_vector& __x, const inplace_vector& __y) {
    return std::lexicographical_compare_three_way(
        __x.begin(), __x.end(), __y.begin(), __y.end(), std::__synth_three_way);
  }

private:
  constexpr void __append_default(size_type __n) {
    if (size_ + __n > Capacity)
      std::__throw_bad_alloc();
    for (size_type __i = 0; __i < __n; ++__i)
      unchecked_emplace_back();
  }

  constexpr void __append_fill(size_type __n, const _Tp& __value) {
    if (size_ + __n > Capacity)
      std::__throw_bad_alloc();
    for (size_type __i = 0; __i < __n; ++__i)
      unchecked_push_back(__value);
  }

  constexpr void __append_copy(const inplace_vector& __other) {
    for (size_type __i = 0; __i < __other.size_; ++__i)
      unchecked_push_back(__other.data()[__i]);
  }

  constexpr void __append_move(inplace_vector& __other) {
    for (size_type __i = 0; __i < __other.size_; ++__i)
      unchecked_push_back(std::move(__other.data()[__i]));
  }

  __inplace_vector_storage<_Tp, Capacity> storage_;
  size_type size_ = 0;
};

template <class _Tp, size_t Capacity, class _Up = _Tp>
constexpr auto erase(inplace_vector<_Tp, Capacity>& __c, const _Up& __value) ->
    typename inplace_vector<_Tp, Capacity>::size_type {
  auto __it = std::remove(__c.begin(), __c.end(), __value);
  auto __r  = static_cast<typename inplace_vector<_Tp, Capacity>::size_type>(__c.end() - __it);
  __c.erase(__it, __c.end());
  return __r;
}

template <class _Tp, size_t Capacity, class Predicate>
constexpr auto erase_if(inplace_vector<_Tp, Capacity>& __c, Predicate __pred) ->
    typename inplace_vector<_Tp, Capacity>::size_type {
  auto __it = std::remove_if(__c.begin(), __c.end(), __pred);
  auto __r  = static_cast<typename inplace_vector<_Tp, Capacity>::size_type>(__c.end() - __it);
  __c.erase(__it, __c.end());
  return __r;
}

_LIBCPP_END_NAMESPACE_STD

_LIBCPP_POP_MACROS

#endif // _LIBCPP_INPLACE_VECTOR
