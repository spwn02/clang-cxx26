#ifndef _LIBCPP_INPLACE_VECTOR
#define _LIBCPP_INPLACE_VECTOR

#include <__compare/synth_three_way.h>
#include <__config>
#include <__memory/construct_at.h>
#include <algorithm>
#include <compare>
#include <cstddef>
#include <initializer_list>
#include <iterator>
#include <new>
#include <stdexcept>
#include <type_traits>
#include <utility>

