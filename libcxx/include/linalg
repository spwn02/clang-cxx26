namespace linalg {
#  define _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_ElementType, _Extents, _Layout, _Accessor)                         \
    static_assert(is_assignable_v<typename mdspan<_ElementType, _Extents, _Layout, _Accessor>::reference, _ElementType>, \
                  "linalg output mdspan must be writable")
#  define _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_Extents, _Layout)                                                  \
    static_assert(_Layout::template mapping<_Extents>::is_always_unique(),                                           \
                  "linalg output mdspan mapping must always be unique")

namespace __detail {

template <class _Tp>
struct __is_std_complex : false_type {};

template <class _Tp>
struct __is_std_complex<complex<_Tp>> : true_type {};

template <class _Tp>
inline constexpr bool __is_std_complex_v = __is_std_complex<remove_cv_t<_Tp>>::value;

template <class _Tp>
inline constexpr bool __is_floating_point_or_complex_v = is_floating_point_v<remove_cv_t<_Tp>> || __is_std_complex_v<_Tp>;

template <class _Tp>
struct __real_type {
  using type = remove_cv_t<_Tp>;
};
template <class _Tp>
struct __real_type<complex<_Tp>> {
  using type = _Tp;
};
template <class _Tp>
using __real_type_t = typename __real_type<remove_cv_t<_Tp>>::type;

// [linalg.algs.blas1.dot], [linalg.algs.blas1.nrm2], [linalg.algs.blas1.matfrobnorm] Remarks: when Scalar has higher
// precision than the value type, the intermediate terms use Scalar's precision.
template <class _Scalar, class _Value>
inline constexpr bool __is_promoted_to_scalar_precision_v =
    __is_floating_point_or_complex_v<_Value> && __is_floating_point_or_complex_v<_Scalar> &&
    numeric_limits<__real_type_t<_Scalar>>::digits > numeric_limits<__real_type_t<_Value>>::digits;

template <class _Scalar, class _Value>
constexpr auto __promote_to_scalar_precision(const _Value& __value) {
  using _Plain = remove_cvref_t<_Value>;
  if constexpr (__is_promoted_to_scalar_precision_v<_Scalar, _Plain>) {
    using _Real = __real_type_t<_Scalar>;
    if constexpr (__is_std_complex_v<_Plain>)
      return complex<_Real>(__value);
    else
      return static_cast<_Real>(__value);
  } else {
    return _Plain(__value);
  }
}

template <class _LeftExtents, size_t _LeftDimension, class _RightExtents, size_t _RightDimension>
consteval bool __static_extents_match() {
  return _LeftExtents::static_extent(_LeftDimension) == dynamic_extent ||
         _RightExtents::static_extent(_RightDimension) == dynamic_extent ||
         _LeftExtents::static_extent(_LeftDimension) == _RightExtents::static_extent(_RightDimension);
}

template <class _LeftExtents, class _RightExtents>
consteval bool __static_extents_match() {
  if constexpr (_LeftExtents::rank() != _RightExtents::rank()) {
    return false;
  } else {
    for (size_t __i = 0; __i != _LeftExtents::rank(); ++__i)
      if (_LeftExtents::static_extent(__i) != dynamic_extent && _RightExtents::static_extent(__i) != dynamic_extent &&
          _LeftExtents::static_extent(__i) != _RightExtents::static_extent(__i))
        return false;
    return true;
  }
}

// This deleted overload ensures that lookup finds only an ADL customization.
template <class _Tp>
void conj(const _Tp&) = delete;

template <class _Tp>
concept __has_adl_conj =
    !is_arithmetic_v<remove_cvref_t<_Tp>> && requires(_Tp&& __value) { conj(std::forward<_Tp>(__value)); };

template <class _Tp>
constexpr auto __conj_if_needed(_Tp&& __value) {
  if constexpr (__has_adl_conj<_Tp>)
    return conj(std::forward<_Tp>(__value));
  else
    return std::forward<_Tp>(__value);
}

// These deleted overloads ensure that lookup finds only ADL customizations.
template <class _Tp>
void abs(const _Tp&) = delete;

template <class _Tp>
void real(const _Tp&) = delete;

template <class _Tp>
concept __has_adl_real =
    !is_arithmetic_v<remove_cvref_t<_Tp>> && requires(_Tp&& __value) { real(std::forward<_Tp>(__value)); };

template <class _Tp>
constexpr auto __real_if_needed(_Tp&& __value) {
  if constexpr (__has_adl_real<_Tp>)
    return real(std::forward<_Tp>(__value));
  else
    return std::forward<_Tp>(__value);
}

template <class _Tp>
void imag(const _Tp&) = delete;

template <class _Tp>
concept __has_adl_imag =
    !is_arithmetic_v<remove_cvref_t<_Tp>> && requires(_Tp&& __value) { imag(std::forward<_Tp>(__value)); };

template <class _Tp>
constexpr auto __imag_if_needed(_Tp&& __value) {
  if constexpr (__has_adl_imag<_Tp>)
    return imag(std::forward<_Tp>(__value));
  else
    return remove_cvref_t<_Tp>{};
}

template <class _Tp>
constexpr auto __abs_if_needed(_Tp&& __value) {
  if constexpr (is_unsigned_v<remove_cvref_t<_Tp>>) {
    return std::forward<_Tp>(__value);
  } else {
    using std::abs;
    return abs(std::forward<_Tp>(__value));
  }
}

template <class _Tp>
constexpr auto __blas_abs(_Tp&& __value) {
  if constexpr (__has_adl_real<_Tp> || __has_adl_imag<_Tp>) {
    return __abs_if_needed(__real_if_needed(__value)) + __abs_if_needed(__imag_if_needed(__value));
  } else {
    return __abs_if_needed(std::forward<_Tp>(__value));
  }
}

// Execution policies permit an implementation to fall back to serial execution.
// Keep element accesses in a noexcept boundary, as required for policy algorithms.
template <class _Function>
constexpr decltype(auto) __serial_execution(_Function&& __function) noexcept {
  return std::forward<_Function>(__function)();
}

