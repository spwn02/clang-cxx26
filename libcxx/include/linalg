struct upper_triangle_t {
  explicit upper_triangle_t() = default;
};
struct lower_triangle_t {
  explicit lower_triangle_t() = default;
};
struct implicit_unit_diagonal_t {
  explicit implicit_unit_diagonal_t() = default;
};
struct explicit_diagonal_t {
  explicit explicit_diagonal_t() = default;
};
struct column_major_t {
  explicit column_major_t() = default;
};
struct row_major_t {
  explicit row_major_t() = default;
};

inline constexpr upper_triangle_t upper_triangle{};
inline constexpr lower_triangle_t lower_triangle{};
inline constexpr implicit_unit_diagonal_t implicit_unit_diagonal{};
inline constexpr explicit_diagonal_t explicit_diagonal{};
inline constexpr column_major_t column_major{};
inline constexpr row_major_t row_major{};

namespace __detail {
template <class _Tp>
concept __triangle_tag =
    same_as<remove_cvref_t<_Tp>, upper_triangle_t> || same_as<remove_cvref_t<_Tp>, lower_triangle_t>;

template <class _Tp>
concept __diagonal_tag =
    same_as<remove_cvref_t<_Tp>, implicit_unit_diagonal_t> || same_as<remove_cvref_t<_Tp>, explicit_diagonal_t>;

template <class _Tp>
concept __storage_order_tag = same_as<remove_cvref_t<_Tp>, column_major_t> || same_as<remove_cvref_t<_Tp>, row_major_t>;
} // namespace __detail

template <class _Triangle, class _StorageOrder>
class layout_blas_packed {
  static_assert(__detail::__triangle_tag<_Triangle>, "layout_blas_packed requires an upper or lower triangle tag");
  static_assert(__detail::__storage_order_tag<_StorageOrder>,
                "layout_blas_packed requires a row or column major storage order tag");

public:
  using triangle_type      = _Triangle;
  using storage_order_type = _StorageOrder;

  template <class _Extents>
  class mapping {
    static_assert(__mdspan_detail::__is_extents<_Extents>::value,
                  "layout_blas_packed::mapping template argument must be a specialization of extents");
    static_assert(_Extents::rank() == 2, "layout_blas_packed::mapping requires rank-two extents");
    static_assert(__detail::__static_extents_match<_Extents, 0, _Extents, 1>(),
                  "layout_blas_packed::mapping requires square static extents");

    // required_span_size() is __size * (__size + 1) / 2. Checking the full
    // product __size * (__size + 1) for overflow is stricter than the standard
    // requires: for a narrow index_type the halved result can be representable
    // while the intermediate product is not. Exactly one of __size and
    // __size + 1 is even, so fold the division in before multiplying.
    _LIBCPP_HIDE_FROM_ABI static constexpr bool __span_size_is_representable(typename _Extents::index_type __size) {
      using _Index = typename _Extents::index_type;
      _Index __half;
      _Index __other;
      if (__size % _Index(2) == _Index(0)) {
        // __size is even, so __size != the maximum value and __size + 1 cannot
        // overflow.
        __half  = static_cast<_Index>(__size / _Index(2));
        __other = static_cast<_Index>(__size + _Index(1));
      } else {
        // (__size + 1) / 2 == __size / 2 + 1 for odd __size, computed without
        // forming __size + 1.
        __half  = static_cast<_Index>(__size / _Index(2) + _Index(1));
        __other = __size;
      }
      _Index __product;
      return !__builtin_mul_overflow(__half, __other, std::addressof(__product));
    }

    static_assert(_Extents::rank_dynamic() > 0 || __span_size_is_representable(_Extents::static_extent(0)),
                  "layout_blas_packed::mapping required span size must be representable as index_type");

  public:
    using extents_type = _Extents;
    using index_type   = typename extents_type::index_type;
    using size_type    = typename extents_type::size_type;
    using rank_type    = typename extents_type::rank_type;
    using layout_type  = layout_blas_packed;

    _LIBCPP_HIDE_FROM_ABI constexpr mapping() noexcept               = default;
    _LIBCPP_HIDE_FROM_ABI constexpr mapping(const mapping&) noexcept = default;
    _LIBCPP_HIDE_FROM_ABI constexpr mapping(const extents_type& __extents) noexcept : __extents_(__extents) {
      _LIBCPP_ASSERT_VALID_ELEMENT_ACCESS(
          __extents.extent(0) == __extents.extent(1), "layout_blas_packed::mapping requires square extents");
      _LIBCPP_ASSERT_VALID_ELEMENT_ACCESS(
          __span_size_is_representable(__extents.extent(0)),
          "layout_blas_packed::mapping required span size is not representable as index_type");
    }

    template <class _OtherExtents>
      requires is_constructible_v<extents_type, _OtherExtents>
    _LIBCPP_HIDE_FROM_ABI constexpr explicit(!is_convertible_v<_OtherExtents, extents_type>)
        mapping(const mapping<_OtherExtents>& __other) noexcept
        : mapping(extents_type(__other.extents())) {}

    _LIBCPP_HIDE_FROM_ABI constexpr mapping& operator=(const mapping&) noexcept = default;

    _LIBCPP_HIDE_FROM_ABI constexpr const extents_type& extents() const noexcept { return __extents_; }

    _LIBCPP_HIDE_FROM_ABI constexpr index_type required_span_size() const noexcept {
      return __extents_.extent(0) * (__extents_.extent(0) + index_type(1)) / index_type(2);
    }

    template <class _Index0, class _Index1>
      requires is_convertible_v<_Index0, index_type> && is_convertible_v<_Index1, index_type> &&
               is_nothrow_constructible_v<index_type, _Index0> && is_nothrow_constructible_v<index_type, _Index1>
    _LIBCPP_HIDE_FROM_ABI constexpr index_type operator()(_Index0 __ind0, _Index1 __ind1) const noexcept {
      index_type __i = static_cast<index_type>(__ind0);
      index_type __j = static_cast<index_type>(__ind1);
      _LIBCPP_ASSERT_UNCATEGORIZED(__mdspan_detail::__is_multidimensional_index_in(__extents_, __i, __j),
                                   "layout_blas_packed::mapping: out of bounds indexing");
      if (__i > __j) {
        const index_type __tmp = __i;
        __i                    = __j;
        __j                    = __tmp;
      }
      if constexpr ((same_as<_StorageOrder, column_major_t> && same_as<_Triangle, upper_triangle_t>) ||
                    (same_as<_StorageOrder, row_major_t> && same_as<_Triangle, lower_triangle_t>))
        return __i + __j * (__j + index_type(1)) / index_type(2);
      else
        return __j + __extents_.extent(0) * __i - __i * (__i + index_type(1)) / index_type(2);
    }

    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_unique() noexcept {
      return (_Extents::static_extent(0) != dynamic_extent && _Extents::static_extent(0) < 2) ||
             (_Extents::static_extent(1) != dynamic_extent && _Extents::static_extent(1) < 2);
    }
    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_exhaustive() noexcept { return true; }
    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_strided() noexcept { return is_always_unique(); }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_unique() const noexcept { return __extents_.extent(0) < 2; }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_exhaustive() const noexcept { return true; }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_strided() const noexcept { return is_unique(); }
    _LIBCPP_HIDE_FROM_ABI constexpr index_type stride([[maybe_unused]] rank_type __rank) const noexcept {
      _LIBCPP_ASSERT_VALID_ELEMENT_ACCESS(
          is_strided() && __rank < 2, "layout_blas_packed::mapping::stride(): mapping is not strided");
      return index_type(1);
    }

    template <class _OtherExtents>
      requires(_OtherExtents::rank() == 2)
    _LIBCPP_HIDE_FROM_ABI friend constexpr bool
    operator==(const mapping& __left, const mapping<_OtherExtents>& __right) noexcept {
      return __left.extents() == __right.extents();
    }

  private:
    _LIBCPP_NO_UNIQUE_ADDRESS extents_type __extents_{};
  };
};

template <class _Layout>
class layout_transpose {
public:
  using nested_layout_type = _Layout;

  template <class _Extents>
  class mapping {
    static_assert(__mdspan_detail::__is_extents<_Extents>::value,
                  "layout_transpose::mapping template argument must be a specialization of extents");
    static_assert(_Extents::rank() == 2, "layout_transpose::mapping requires rank-two extents");

    using __nested_extents =
        extents<typename _Extents::index_type, _Extents::static_extent(1), _Extents::static_extent(0)>;
    using __nested_mapping = typename _Layout::template mapping<__nested_extents>;

  public:
    using extents_type        = _Extents;
    using index_type          = typename extents_type::index_type;
    using size_type           = typename extents_type::size_type;
    using rank_type           = typename extents_type::rank_type;
    using layout_type         = layout_transpose;
    using nested_mapping_type = __nested_mapping;

    _LIBCPP_HIDE_FROM_ABI constexpr explicit mapping(const nested_mapping_type& __mapping)
        : __nested_mapping_(__mapping), __extents_(__mapping.extents().extent(1), __mapping.extents().extent(0)) {}

    _LIBCPP_HIDE_FROM_ABI constexpr const extents_type& extents() const noexcept { return __extents_; }
    _LIBCPP_HIDE_FROM_ABI constexpr index_type required_span_size() const noexcept {
      return __nested_mapping_.required_span_size();
    }
    template <class _Index0, class _Index1>
      requires requires(const nested_mapping_type& __mapping, _Index0 __ind0, _Index1 __ind1) {
        __mapping(__ind1, __ind0);
      }
    _LIBCPP_HIDE_FROM_ABI constexpr index_type operator()(_Index0 __ind0, _Index1 __ind1) const
        noexcept(noexcept(__nested_mapping_(__ind1, __ind0))) {
      return __nested_mapping_(__ind1, __ind0);
    }
    _LIBCPP_HIDE_FROM_ABI constexpr const nested_mapping_type& nested_mapping() const noexcept {
      return __nested_mapping_;
    }

    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_unique() noexcept {
      return nested_mapping_type::is_always_unique();
    }
    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_exhaustive() noexcept {
      return nested_mapping_type::is_always_exhaustive();
    }
    _LIBCPP_HIDE_FROM_ABI static constexpr bool is_always_strided() noexcept {
      return nested_mapping_type::is_always_strided();
    }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_unique() const noexcept { return __nested_mapping_.is_unique(); }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_exhaustive() const noexcept { return __nested_mapping_.is_exhaustive(); }
    _LIBCPP_HIDE_FROM_ABI constexpr bool is_strided() const noexcept { return __nested_mapping_.is_strided(); }
    _LIBCPP_HIDE_FROM_ABI constexpr index_type stride(rank_type __rank) const noexcept {
      _LIBCPP_ASSERT_VALID_ELEMENT_ACCESS(
          is_strided() && __rank < 2, "layout_transpose::mapping::stride(): mapping is not strided");
      return __nested_mapping_.stride(__rank == 0 ? 1 : 0);
    }

  private:
    _LIBCPP_NO_UNIQUE_ADDRESS nested_mapping_type __nested_mapping_;
    _LIBCPP_NO_UNIQUE_ADDRESS extents_type __extents_;
  };
};

