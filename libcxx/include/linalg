template <class _ElementType,
          class _Extents,
          class _Layout,
          class _Accessor,
          class _OutputElementType,
          class _OutputExtents,
          class _OutputLayout,
          class _OutputAccessor>
constexpr void __copy_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __in_span,
                     mdspan<_OutputElementType, _OutputExtents, _OutputLayout, _OutputAccessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_OutputElementType, _OutputExtents, _OutputLayout, _OutputAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_OutputExtents, _OutputLayout);
  static_assert(_Extents::rank() == _OutputExtents::rank() && _Extents::rank() <= 2,
                "linalg::copy requires matching rank-zero, rank-one, or rank-two mdspans");
  static_assert(
      __detail::__static_extents_match<_Extents, _OutputExtents>(), "linalg::copy requires matching static extents");
  if constexpr (_Extents::rank() == 0)
    __out_span[] = __in_span[];
  else if constexpr (_Extents::rank() == 1)
    for (size_t __i = 0; __i != __in_span.extent(0); ++__i)
      __out_span[__i] = __in_span[__i];
  else
    for (size_t __i = 0; __i != __in_span.extent(0); ++__i)
      for (size_t __j = 0; __j != __in_span.extent(1); ++__j)
        __out_span[__i, __j] = __in_span[__i, __j];
}

template <class _Scalar, class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr void __scale_impl(_Scalar __alpha, mdspan<_ElementType, _Extents, _Layout, _Accessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_ElementType, _Extents, _Layout, _Accessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_Extents, _Layout);
  static_assert(_Extents::rank() <= 2, "linalg::scale requires a rank-zero, rank-one, or rank-two mdspan");
  if constexpr (_Extents::rank() == 0)
    __out_span[] = __alpha * __out_span[];
  else if constexpr (_Extents::rank() == 1)
    for (size_t __i = 0; __i != __out_span.extent(0); ++__i)
      __out_span[__i] = __alpha * __out_span[__i];
  else
    for (size_t __i = 0; __i != __out_span.extent(0); ++__i)
      for (size_t __j = 0; __j != __out_span.extent(1); ++__j)
        __out_span[__i, __j] = __alpha * __out_span[__i, __j];
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor,
          class _OutputElement,
          class _OutputExtents,
          class _OutputLayout,
          class _OutputAccessor>
constexpr void __add_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
                    mdspan<_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_OutputExtents, _OutputLayout);
  static_assert(_LeftExtents::rank() == _RightExtents::rank() && _RightExtents::rank() == _OutputExtents::rank() &&
                    _OutputExtents::rank() <= 2,
                "linalg::add requires matching rank-zero, rank-one, or rank-two mdspans");
  // possibly-addable checks every pair, not a chain through one operand: with
  // a dynamic extent on the left, left~right and left~output can both hold
  // while right and output are statically incompatible.
  static_assert(__detail::__static_extents_match<_LeftExtents, _RightExtents>() &&
                    __detail::__static_extents_match<_LeftExtents, _OutputExtents>() &&
                    __detail::__static_extents_match<_RightExtents, _OutputExtents>(),
                "linalg::add requires matching static extents");
  if constexpr (_OutputExtents::rank() == 0)
    __out_span[] = __left[] + __right[];
  else if constexpr (_OutputExtents::rank() == 1)
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      __out_span[__i] = __left[__i] + __right[__i];
  else
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      for (size_t __j = 0; __j != __left.extent(1); ++__j)
        __out_span[__i, __j] = __left[__i, __j] + __right[__i, __j];
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr auto __dot_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                   mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
                   auto __init)
  requires(__detail::__in_vector<mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor>> &&
           __detail::__in_vector<mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor>> &&
           __detail::__linalg_scalar<decltype(__init)>)
{
  static_assert(_LeftExtents::rank() == 1 && _RightExtents::rank() == 1, "linalg::dot requires rank-one mdspans");
  static_assert(
      __detail::__static_extents_match<_LeftExtents, _RightExtents>(), "linalg::dot requires matching static extents");
  using _Scalar = decltype(__init);
  if constexpr (__detail::__is_floating_point_or_complex_v<_LeftElement> &&
                __detail::__is_floating_point_or_complex_v<_RightElement> &&
                __detail::__is_floating_point_or_complex_v<_Scalar>) {
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      __init += __detail::__promote_to_scalar_precision<_Scalar>(__left[__i]) *
                __detail::__promote_to_scalar_precision<_Scalar>(__right[__i]);
  } else {
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      __init += __left[__i] * __right[__i];
  }
  return __init;
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr auto __dot_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                   mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right)
  requires(__detail::__in_vector<mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor>> &&
           __detail::__in_vector<mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor>>)
{
  using _Result = decltype(declval<remove_cv_t<_LeftElement>>() * declval<remove_cv_t<_RightElement>>());
  return dot(__left, __right, _Result{});
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr auto __dotc_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
                    auto __init)
  requires(__detail::__in_vector<mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor>> &&
           __detail::__in_vector<mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor>> &&
           __detail::__linalg_scalar<decltype(__init)>)
{
  return dot(conjugated(__left), __right, __init);
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr auto __dotc_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right)
  requires(__detail::__in_vector<mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor>> &&
           __detail::__in_vector<mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor>>)
{
  using _Result = decltype(__detail::__conj_if_needed(declval<remove_cv_t<_LeftElement>>()) *
                           declval<remove_cv_t<_RightElement>>());
  return dotc(__left, __right, _Result{});
}

// [linalg.algs.blas1.nrm2] specifies the return type as Scalar, the type of
// init, so the square root has to be converted back rather than returned as
// whatever sqrt() happens to produce.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar __vector_two_norm_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector, _Scalar __init)
  requires(__detail::__in_vector<mdspan<_ElementType, _Extents, _Layout, _Accessor>> &&
           __detail::__linalg_scalar<_Scalar>)
{
  static_assert(_Extents::rank() == 1, "linalg::vector_two_norm requires a rank-one mdspan");
  static_assert(__detail::__is_floating_point_or_complex_v<_ElementType> &&
                    __detail::__is_floating_point_or_complex_v<_Scalar>,
                "linalg::vector_two_norm requires a floating-point or complex value_type and Scalar");
  static_assert(
      is_convertible_v<decltype(__detail::__abs_if_needed(declval<_Scalar>()) * __detail::__abs_if_needed(declval<_Scalar>()) +
                                __detail::__abs_if_needed(declval<remove_cv_t<_ElementType>>()) *
                                    __detail::__abs_if_needed(declval<remove_cv_t<_ElementType>>())),
                       _Scalar>,
      "linalg::vector_two_norm: the sum of squares must be convertible to Scalar");
  auto __sum = __detail::__abs_if_needed(__init) * __detail::__abs_if_needed(__init);
  for (size_t __i = 0; __i != __vector.extent(0); ++__i) {
    const auto __value = __detail::__promote_to_scalar_precision<_Scalar>(__detail::__abs_if_needed(__vector[__i]));
    __sum += __value * __value;
  }
  using std::sqrt;
  return static_cast<_Scalar>(sqrt(__sum));
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto __vector_two_norm_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector)
  requires __detail::__in_vector<mdspan<_ElementType, _Extents, _Layout, _Accessor>>
{
  using _Value  = remove_cv_t<_ElementType>;
  using _Result = decltype(__detail::__abs_if_needed(declval<_Value>()) * __detail::__abs_if_needed(declval<_Value>()));
  return vector_two_norm(__vector, _Result{});
}

template <class _Real>
struct setup_givens_rotation_result {
  _Real c;
  _Real s;
  _Real r;
};

template <class _Real>
struct setup_givens_rotation_result<complex<_Real>> {
  _Real c;
  complex<_Real> s;
  complex<_Real> r;
};

template <class _Real>
  requires(!__detail::__is_std_complex_v<_Real>)
auto setup_givens_rotation(_Real __a, _Real __b) noexcept {
  using std::sqrt;
  const _Real __r = sqrt(__a * __a + __b * __b);
  if (__r == _Real{})
    return setup_givens_rotation_result<_Real>{_Real(1), _Real{}, _Real{}};
  return setup_givens_rotation_result<_Real>{__a / __r, __b / __r, __r};
}

template <class _Real>
auto setup_givens_rotation(complex<_Real> __a, complex<_Real> __b) noexcept {
  using std::abs;
  using std::sqrt;
  const _Real __norm = sqrt(abs(__a) * abs(__a) + abs(__b) * abs(__b));
  if (__norm == _Real{})
    return setup_givens_rotation_result<complex<_Real>>{_Real(1), complex<_Real>{}, complex<_Real>{}};
  if (abs(__a) == _Real{})
    return setup_givens_rotation_result<complex<_Real>>{_Real{}, conj(__b) / __norm, complex<_Real>{__norm}};
  const complex<_Real> __alpha = __a / abs(__a);
  return setup_givens_rotation_result<complex<_Real>>{
      abs(__a) / __norm, __alpha * conj(__b) / __norm, __alpha * __norm};
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor,
          class _Real,
          class _Sine>
constexpr void __apply_givens_rotation_impl(
    mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
    _Real __c,
    _Sine __s)
  requires(__detail::__inout_vector<mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor>> &&
           __detail::__inout_vector<mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor>>)
{
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor);
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_RightElement, _RightExtents, _RightLayout, _RightAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_LeftExtents, _LeftLayout);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_RightExtents, _RightLayout);
  static_assert(_LeftExtents::rank() == 1 && _RightExtents::rank() == 1,
                "linalg::apply_givens_rotation requires rank-one mdspans");
  static_assert(__detail::__static_extents_match<_LeftExtents, _RightExtents>(),
                "linalg::apply_givens_rotation requires matching static extents");
  for (size_t __i = 0; __i != __left.extent(0); ++__i) {
    const auto __left_value  = __left[__i];
    const auto __right_value = __right[__i];
    __left[__i]              = __c * __left_value + __s * __right_value;
    __right[__i]             = -__detail::__conj_if_needed(__s) * __left_value + __c * __right_value;
  }
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr void __swap_elements_impl(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                              mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor);
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_RightElement, _RightExtents, _RightLayout, _RightAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_LeftExtents, _LeftLayout);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_RightExtents, _RightLayout);
  static_assert(_LeftExtents::rank() == _RightExtents::rank() && _LeftExtents::rank() <= 2,
                "linalg::swap_elements requires matching rank-zero, rank-one, or rank-two mdspans");
  static_assert(__detail::__static_extents_match<_LeftExtents, _RightExtents>(),
                "linalg::swap_elements requires matching static extents");
  if constexpr (_LeftExtents::rank() == 0)
    swap(__left[], __right[]);
  else if constexpr (_LeftExtents::rank() == 1)
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      swap(__left[__i], __right[__i]);
  else
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      for (size_t __j = 0; __j != __left.extent(1); ++__j)
        swap(__left[__i, __j], __right[__i, __j]);
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto __vector_abs_sum_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector, auto __init)
  requires(__detail::__in_vector<mdspan<_ElementType, _Extents, _Layout, _Accessor>> &&
           __detail::__linalg_scalar<decltype(__init)>)
{
  static_assert(_Extents::rank() == 1, "linalg::vector_abs_sum requires a rank-one mdspan");
  for (size_t __i = 0; __i != __vector.extent(0); ++__i)
    __init += __detail::__blas_abs(__vector[__i]);
  return __init;
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto __vector_abs_sum_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector)
  requires __detail::__in_vector<mdspan<_ElementType, _Extents, _Layout, _Accessor>>
{
  using _Result = decltype(__detail::__blas_abs(__vector[0]));
  return vector_abs_sum(__vector, _Result{});
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
  requires __detail::__in_vector<mdspan<_ElementType, _Extents, _Layout, _Accessor>>
constexpr typename mdspan<_ElementType, _Extents, _Layout, _Accessor>::size_type
__vector_idx_abs_max_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector) {
  static_assert(_Extents::rank() == 1, "linalg::vector_idx_abs_max requires a rank-one mdspan");
  using _Size = typename mdspan<_ElementType, _Extents, _Layout, _Accessor>::size_type;
  if (__vector.extent(0) == 0)
    return numeric_limits<_Size>::max();
  _Size __result{};
  auto __maximum = __detail::__blas_abs(__vector[0]);
  for (_Size __i = 1; __i != __vector.extent(0); ++__i) {
    const auto __value = __detail::__blas_abs(__vector[__i]);
    if (__maximum < __value) {
      __maximum = __value;
      __result  = __i;
    }
  }
  return __result;
}

// As with vector_two_norm, [linalg.algs.blas1.matfrobnorm] fixes the return
// type to Scalar rather than the type of the sqrt() result.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar __matrix_frob_norm_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix, _Scalar __init)
  requires(__detail::__in_matrix<mdspan<_ElementType, _Extents, _Layout, _Accessor>> &&
           __detail::__linalg_scalar<_Scalar>)
{
  static_assert(_Extents::rank() == 2, "linalg::matrix_frob_norm requires a rank-two mdspan");
  static_assert(__detail::__is_floating_point_or_complex_v<_ElementType> &&
                    __detail::__is_floating_point_or_complex_v<_Scalar>,
                "linalg::matrix_frob_norm requires a floating-point or complex value_type and Scalar");
  static_assert(
      is_convertible_v<decltype(__detail::__abs_if_needed(declval<_Scalar>()) * __detail::__abs_if_needed(declval<_Scalar>()) +
                                __detail::__abs_if_needed(declval<remove_cv_t<_ElementType>>()) *
                                    __detail::__abs_if_needed(declval<remove_cv_t<_ElementType>>())),
                       _Scalar>,
      "linalg::matrix_frob_norm: the sum of squares must be convertible to Scalar");
  auto __sum = __detail::__abs_if_needed(__init) * __detail::__abs_if_needed(__init);
  for (size_t __i = 0; __i != __matrix.extent(0); ++__i)
    for (size_t __j = 0; __j != __matrix.extent(1); ++__j) {
      const auto __value = __detail::__promote_to_scalar_precision<_Scalar>(__detail::__abs_if_needed(__matrix[__i, __j]));
      __sum += __value * __value;
    }
  using std::sqrt;
  return static_cast<_Scalar>(sqrt(__sum));
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto __matrix_frob_norm_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix)
  requires __detail::__in_matrix<mdspan<_ElementType, _Extents, _Layout, _Accessor>>
{
  using _Value  = remove_cv_t<_ElementType>;
  using _Result = decltype(__detail::__abs_if_needed(declval<_Value>()) * __detail::__abs_if_needed(declval<_Value>()));
  return matrix_frob_norm(__matrix, _Result{});
}

// Returns Scalar exactly; `__init + __maximum` would integer-promote for
// narrow scalar types such as short.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar __matrix_one_norm_impl(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix, _Scalar __init)
  requires(__detail::__in_matrix<mdspan<_ElementType, _Extents, _Layout, _Accessor>> &&
           __detail::__linalg_scalar<_Scalar>)
{
  static_assert(_Extents::rank() == 2, "linalg::matrix_one_norm requires a rank-two mdspan");
  auto __maximum = _Scalar{};
  for (size_t __j = 0; __j != __matrix.extent(1); ++__j) {
    auto __sum = _Scalar{};
    for (size_t __i = 0; __i != __matrix.extent(0); ++__i)
      __sum += __detail::__abs_if_needed(__matrix[__i, __j]);
    if (__maximum < __sum)
      __maximum = __sum;
  }
  return static_cast<_Scalar>(__init + __maximum);
