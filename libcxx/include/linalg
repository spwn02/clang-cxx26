                "linalg::triangular_matrix_vector_solve requires a matrix and two vectors");
  static_assert(__detail::__static_extents_match<_MatrixExtents, 0, _MatrixExtents, 1>() &&
                    __detail::__static_extents_match<_MatrixExtents, 0, _VectorExtents, 0>() &&
                    __detail::__static_extents_match<_VectorExtents, _OutputExtents>(),
