template <class _MatrixElement,
          class _MatrixExtents,
          class _MatrixLayout,
          class _MatrixAccessor,
          class _VectorElement,
          class _VectorExtents,
          class _VectorLayout,
          class _VectorAccessor,
          class _OutputElement,
          class _OutputExtents,
          class _OutputLayout,
          class _OutputAccessor>
constexpr void matrix_vector_product(mdspan<_MatrixElement, _MatrixExtents, _MatrixLayout, _MatrixAccessor> __matrix,
                                      mdspan<_VectorElement, _VectorExtents, _VectorLayout, _VectorAccessor> __vector,
                                      mdspan<_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_OutputExtents, _OutputLayout);
  static_assert(_MatrixExtents::rank() == 2 && _VectorExtents::rank() == 1 && _OutputExtents::rank() == 1,
                "linalg::matrix_vector_product requires a matrix and two vectors");
  static_assert(__detail::__static_extents_match<_MatrixExtents, 1, _VectorExtents, 0>() &&
                    __detail::__static_extents_match<_MatrixExtents, 0, _OutputExtents, 0>(),
                "linalg::matrix_vector_product requires compatible static extents");
  for (size_t __i = 0; __i != __matrix.extent(0); ++__i) {
    decltype(__matrix[0, 0] * __vector[0]) __sum{};
    for (size_t __j = 0; __j != __matrix.extent(1); ++__j)
      __sum += __matrix[__i, __j] * __vector[__j];
    __out_span[__i] = __sum;
  }
}

template <class _MatrixElement,
          class _MatrixExtents,
          class _MatrixLayout,
          class _MatrixAccessor,
          class _VectorElement,
          class _VectorExtents,
          class _VectorLayout,
          class _VectorAccessor,
          class _AddElement,
          class _AddExtents,
          class _AddLayout,
          class _AddAccessor,
          class _OutputElement,
          class _OutputExtents,
          class _OutputLayout,
          class _OutputAccessor>
constexpr void matrix_vector_product(
    mdspan<_MatrixElement, _MatrixExtents, _MatrixLayout, _MatrixAccessor> __matrix,
    mdspan<_VectorElement, _VectorExtents, _VectorLayout, _VectorAccessor> __vector,
    mdspan<_AddElement, _AddExtents, _AddLayout, _AddAccessor> __add,
    mdspan<_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_OutputExtents, _OutputLayout);
  static_assert(_MatrixExtents::rank() == 2 && _VectorExtents::rank() == 1 && _AddExtents::rank() == 1 &&
                    _OutputExtents::rank() == 1,
                "linalg::matrix_vector_product requires a matrix and three vectors");
  static_assert(__detail::__static_extents_match<_MatrixExtents, 1, _VectorExtents, 0>() &&
                    __detail::__static_extents_match<_MatrixExtents, 0, _AddExtents, 0>() &&
                    __detail::__static_extents_match<_MatrixExtents, 0, _OutputExtents, 0>() &&
                    // possibly-addable requires the addend/output pair directly.
                    __detail::__static_extents_match<_AddExtents, 0, _OutputExtents, 0>(),
                "linalg::matrix_vector_product requires compatible static extents");
  for (size_t __i = 0; __i != __matrix.extent(0); ++__i) {
    decltype(__matrix[0, 0] * __vector[0] + __add[0]) __sum = __add[__i];
    for (size_t __j = 0; __j != __matrix.extent(1); ++__j)
      __sum += __matrix[__i, __j] * __vector[__j];
    __out_span[__i] = __sum;
  }
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor,
          class _OutputElement,
          class _OutputExtents,
          class _OutputLayout,
          class _OutputAccessor>
constexpr void matrix_product(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                               mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
                               mdspan<_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor> __out_span) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_OutputElement, _OutputExtents, _OutputLayout, _OutputAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_OutputExtents, _OutputLayout);
  static_assert(_LeftExtents::rank() == 2 && _RightExtents::rank() == 2 && _OutputExtents::rank() == 2,
                "linalg::matrix_product requires three matrices");
  static_assert(__detail::__static_extents_match<_LeftExtents, 1, _RightExtents, 0>() &&
