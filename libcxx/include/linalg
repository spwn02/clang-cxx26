constexpr auto dotc(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right) {
  using _Result = decltype(__detail::__conj_if_needed(__left[0]) * __right[0]);
  return dotc(__left, __right, _Result{});
}

// [linalg.algs.blas1.nrm2] specifies the return type as Scalar, the type of
// init, so the square root has to be converted back rather than returned as
// whatever sqrt() happens to produce.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar vector_two_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector, _Scalar __init) {
  static_assert(_Extents::rank() == 1, "linalg::vector_two_norm requires a rank-one mdspan");
  auto __sum = __detail::__abs_if_needed(__init) * __detail::__abs_if_needed(__init);
  for (size_t __i = 0; __i != __vector.extent(0); ++__i) {
    const auto __value = __detail::__abs_if_needed(__vector[__i]);
    __sum += __value * __value;
  }
  using std::sqrt;
  return static_cast<_Scalar>(sqrt(__sum));
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto vector_two_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector) {
  using _Result = decltype(__detail::__abs_if_needed(__vector[0]) * __detail::__abs_if_needed(__vector[0]));
  return vector_two_norm(__vector, _Result{});
}

template <class _Scalar>
struct sum_of_squares_result {
  _Scalar scaling_factor;
  _Scalar scaled_sum_of_squares;
};

template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr sum_of_squares_result<_Scalar> vector_sum_of_squares(
    mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector, sum_of_squares_result<_Scalar> __init) {
  static_assert(_Extents::rank() == 1, "linalg::vector_sum_of_squares requires a rank-one mdspan");
  for (size_t __i = 0; __i != __vector.extent(0); ++__i) {
    const _Scalar __value = __detail::__abs_if_needed(__vector[__i]);
    if (__value != _Scalar{}) {
      if (__init.scaling_factor < __value) {
        const _Scalar __ratio = __init.scaling_factor / __value;
        __init.scaled_sum_of_squares = _Scalar(1) + __init.scaled_sum_of_squares * __ratio * __ratio;
        __init.scaling_factor         = __value;
      } else {
        const _Scalar __ratio = __value / __init.scaling_factor;
        __init.scaled_sum_of_squares += __ratio * __ratio;
      }
    }
  }
  return __init;
}

template <class _Real>
struct setup_givens_rotation_result {
  _Real c;
  _Real s;
  _Real r;
};

template <class _Real>
struct setup_givens_rotation_result<complex<_Real>> {
  _Real c;
  complex<_Real> s;
  complex<_Real> r;
};

template <class _Real>
  requires(!__detail::__is_std_complex_v<_Real>)
auto setup_givens_rotation(_Real __a, _Real __b) noexcept {
  using std::sqrt;
  const _Real __r = sqrt(__a * __a + __b * __b);
  if (__r == _Real{})
    return setup_givens_rotation_result<_Real>{_Real(1), _Real{}, _Real{}};
  return setup_givens_rotation_result<_Real>{__a / __r, __b / __r, __r};
}

template <class _Real>
auto setup_givens_rotation(complex<_Real> __a, complex<_Real> __b) noexcept {
  using std::abs;
  using std::sqrt;
  const _Real __norm = sqrt(abs(__a) * abs(__a) + abs(__b) * abs(__b));
  if (__norm == _Real{})
    return setup_givens_rotation_result<complex<_Real>>{_Real(1), complex<_Real>{}, complex<_Real>{}};
  if (abs(__a) == _Real{})
    return setup_givens_rotation_result<complex<_Real>>{_Real{}, conj(__b) / __norm, complex<_Real>{__norm}};
  const complex<_Real> __alpha = __a / abs(__a);
  return setup_givens_rotation_result<complex<_Real>>{
      abs(__a) / __norm, __alpha * conj(__b) / __norm, __alpha * __norm};
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor,
          class _Real,
          class _Sine>
constexpr void apply_givens_rotation(
    mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
    mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right,
    _Real __c,
    _Sine __s) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor);
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_RightElement, _RightExtents, _RightLayout, _RightAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_LeftExtents, _LeftLayout);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_RightExtents, _RightLayout);
  static_assert(_LeftExtents::rank() == 1 && _RightExtents::rank() == 1,
                "linalg::apply_givens_rotation requires rank-one mdspans");
  static_assert(__detail::__static_extents_match<_LeftExtents, _RightExtents>(),
                "linalg::apply_givens_rotation requires matching static extents");
  for (size_t __i = 0; __i != __left.extent(0); ++__i) {
    const auto __left_value  = __left[__i];
    const auto __right_value = __right[__i];
    __left[__i]              = __c * __left_value + __s * __right_value;
    __right[__i]             = -__detail::__conj_if_needed(__s) * __left_value + __c * __right_value;
  }
}

template <class _LeftElement,
          class _LeftExtents,
          class _LeftLayout,
          class _LeftAccessor,
          class _RightElement,
          class _RightExtents,
          class _RightLayout,
          class _RightAccessor>
constexpr void swap_elements(mdspan<_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor> __left,
                              mdspan<_RightElement, _RightExtents, _RightLayout, _RightAccessor> __right) {
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_LeftElement, _LeftExtents, _LeftLayout, _LeftAccessor);
  _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN(_RightElement, _RightExtents, _RightLayout, _RightAccessor);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_LeftExtents, _LeftLayout);
  _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING(_RightExtents, _RightLayout);
  static_assert(_LeftExtents::rank() == _RightExtents::rank() && _LeftExtents::rank() <= 2,
                "linalg::swap_elements requires matching rank-zero, rank-one, or rank-two mdspans");
  static_assert(__detail::__static_extents_match<_LeftExtents, _RightExtents>(),
                "linalg::swap_elements requires matching static extents");
  if constexpr (_LeftExtents::rank() == 0)
    swap(__left[], __right[]);
  else if constexpr (_LeftExtents::rank() == 1)
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      swap(__left[__i], __right[__i]);
  else
    for (size_t __i = 0; __i != __left.extent(0); ++__i)
      for (size_t __j = 0; __j != __left.extent(1); ++__j)
        swap(__left[__i, __j], __right[__i, __j]);
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto vector_abs_sum(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector, auto __init) {
  static_assert(_Extents::rank() == 1, "linalg::vector_abs_sum requires a rank-one mdspan");
  for (size_t __i = 0; __i != __vector.extent(0); ++__i)
    __init += __detail::__blas_abs(__vector[__i]);
  return __init;
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto vector_abs_sum(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector) {
  using _Result = decltype(__detail::__blas_abs(__vector[0]));
  return vector_abs_sum(__vector, _Result{});
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr typename mdspan<_ElementType, _Extents, _Layout, _Accessor>::size_type
vector_idx_abs_max(mdspan<_ElementType, _Extents, _Layout, _Accessor> __vector) {
  static_assert(_Extents::rank() == 1, "linalg::vector_idx_abs_max requires a rank-one mdspan");
  using _Size = typename mdspan<_ElementType, _Extents, _Layout, _Accessor>::size_type;
  if (__vector.extent(0) == 0)
    return numeric_limits<_Size>::max();
  _Size __result{};
  auto __maximum = __detail::__blas_abs(__vector[0]);
  for (_Size __i = 1; __i != __vector.extent(0); ++__i) {
    const auto __value = __detail::__blas_abs(__vector[__i]);
    if (__maximum < __value) {
      __maximum = __value;
      __result  = __i;
    }
  }
  return __result;
}

// As with vector_two_norm, [linalg.algs.blas1.matfrobnorm] fixes the return
// type to Scalar rather than the type of the sqrt() result.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar matrix_frob_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix, _Scalar __init) {
  static_assert(_Extents::rank() == 2, "linalg::matrix_frob_norm requires a rank-two mdspan");
  auto __sum = __detail::__abs_if_needed(__init) * __detail::__abs_if_needed(__init);
  for (size_t __i = 0; __i != __matrix.extent(0); ++__i)
    for (size_t __j = 0; __j != __matrix.extent(1); ++__j) {
      const auto __value = __detail::__abs_if_needed(__matrix[__i, __j]);
      __sum += __value * __value;
    }
  using std::sqrt;
  return static_cast<_Scalar>(sqrt(__sum));
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto matrix_frob_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix) {
  using _Result =
      decltype(__detail::__abs_if_needed(__matrix[0, 0]) * __detail::__abs_if_needed(__matrix[0, 0]));
  return matrix_frob_norm(__matrix, _Result{});
}

// Returns Scalar exactly; `__init + __maximum` would integer-promote for
// narrow scalar types such as short.
template <class _ElementType, class _Extents, class _Layout, class _Accessor, class _Scalar>
constexpr _Scalar matrix_one_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix, _Scalar __init) {
  static_assert(_Extents::rank() == 2, "linalg::matrix_one_norm requires a rank-two mdspan");
  auto __maximum = _Scalar{};
  for (size_t __j = 0; __j != __matrix.extent(1); ++__j) {
    auto __sum = _Scalar{};
    for (size_t __i = 0; __i != __matrix.extent(0); ++__i)
      __sum += __detail::__abs_if_needed(__matrix[__i, __j]);
    if (__maximum < __sum)
      __maximum = __sum;
  }
  return static_cast<_Scalar>(__init + __maximum);
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto matrix_one_norm(mdspan<_ElementType, _Extents, _Layout, _Accessor> __matrix) {
  using _Result = decltype(__detail::__abs_if_needed(__matrix[0, 0]));
  return matrix_one_norm(__matrix, _Result{});
}

