template <class _Extents>
using __transpose_extents_t =
    extents<typename _Extents::index_type, _Extents::static_extent(1), _Extents::static_extent(0)>;

// [linalg.helpers.concepts], linear algebra argument concepts. These are checked via trailing
// requires-clauses on the algorithms below (reconstructing the mdspan type from the deduced
// ElementType/Extents/Layout/Accessor template parameters) rather than by declaring the
// algorithms' parameters as these concepts' opaque type directly: the two are equivalent for
// well-formed calls, but the trailing-requires form avoids restructuring every function's
// parameter list, keeps the extents/layout/accessor names available by their existing names in
// the body, and keeps the diagnosable _LIBCPP_LINALG_REQUIRE_WRITABLE_MDSPAN/
// _LIBCPP_LINALG_REQUIRE_UNIQUE_MAPPING static_asserts (which fire with a message) working
// alongside the SFINAE-visible constraint (which silently removes the overload).
template <class _Tp>
inline constexpr bool __is_mdspan_v = false;
template <class _ElementType, class _Extents, class _Layout, class _Accessor>
inline constexpr bool __is_mdspan_v<mdspan<_ElementType, _Extents, _Layout, _Accessor>> = true;

template <class _Tp>
concept __in_vector = __is_mdspan_v<_Tp> && _Tp::rank() == 1;

template <class _Tp>
concept __out_vector = __is_mdspan_v<_Tp> && _Tp::rank() == 1 &&
                        is_assignable_v<typename _Tp::reference, typename _Tp::element_type> &&
                        _Tp::is_always_unique();

template <class _Tp>
concept __inout_vector = __out_vector<_Tp>;

template <class _Tp>
concept __in_matrix = __is_mdspan_v<_Tp> && _Tp::rank() == 2;

template <class _Tp>
concept __out_matrix = __is_mdspan_v<_Tp> && _Tp::rank() == 2 &&
                        is_assignable_v<typename _Tp::reference, typename _Tp::element_type> &&
                        _Tp::is_always_unique();

template <class _Tp>
concept __inout_matrix = __out_matrix<_Tp>;

template <class _Tp>
concept __possibly_packed_out_matrix =
    __is_mdspan_v<_Tp> && _Tp::rank() == 2 && is_assignable_v<typename _Tp::reference, typename _Tp::element_type> &&
    (_Tp::is_always_unique() || __is_layout_blas_packed_v<typename _Tp::layout_type>);

template <class _Tp>
concept __in_object = __is_mdspan_v<_Tp> && (_Tp::rank() == 1 || _Tp::rank() == 2);

template <class _Tp>
concept __out_object = __is_mdspan_v<_Tp> && (_Tp::rank() == 1 || _Tp::rank() == 2) &&
                        is_assignable_v<typename _Tp::reference, typename _Tp::element_type> &&
                        _Tp::is_always_unique();

template <class _Tp>
concept __inout_object = __out_object<_Tp>;

// Named __linalg_scalar (not __scalar) to avoid colliding with this header's own __detail::scalar-
// adjacent helpers and with the unqualified "scalar" template parameter name used throughout.
template <class _Tp>
concept __linalg_scalar = semiregular<_Tp> && !__is_mdspan_v<_Tp> && !is_execution_policy_v<_Tp>;
} // namespace __detail

template <class _ScalingFactor, class _NestedAccessor>
class scaled_accessor {
public:
  using offset_policy = scaled_accessor<_ScalingFactor, typename _NestedAccessor::offset_policy>;
  using element_type =
      const remove_cvref_t<decltype(declval<_ScalingFactor>() * declval<typename _NestedAccessor::element_type>())>;
  // [linalg.scaled.scaledaccessor]: reference is the non-const element type;
  // access() returns a prvalue, so the const would be observable in decltype.
  using reference        = remove_const_t<element_type>;
  using data_handle_type = typename _NestedAccessor::data_handle_type;

  static_assert(semiregular<_ScalingFactor>, "scaled_accessor requires a semiregular scaling factor");
  static_assert(!is_reference_v<element_type>, "scaled_accessor element_type must not be a reference");
  static_assert(copy_constructible<reference>, "scaled_accessor reference must be copy constructible");

  constexpr scaled_accessor()
    requires default_initializable<_ScalingFactor> && default_initializable<_NestedAccessor>
  = default;

  constexpr scaled_accessor(const _ScalingFactor& __factor, const _NestedAccessor& __accessor)
      : __factor_(__factor), __accessor_(__accessor) {}

  template <class _OtherNestedAccessor>
    requires constructible_from<_NestedAccessor, const _OtherNestedAccessor&>
  constexpr explicit(!is_convertible_v<_OtherNestedAccessor, _NestedAccessor>)
      scaled_accessor(const scaled_accessor<_ScalingFactor, _OtherNestedAccessor>& __other)
      : __factor_(__other.scaling_factor()), __accessor_(__other.nested_accessor()) {}

  constexpr reference access(data_handle_type __handle, size_t __index) const {
    return __factor_ * __accessor_.access(__handle, __index);
  }

  constexpr typename offset_policy::data_handle_type offset(data_handle_type __handle, size_t __index) const {
    return __accessor_.offset(__handle, __index);
  }

  [[nodiscard]] constexpr const _ScalingFactor& scaling_factor() const noexcept { return __factor_; }
  [[nodiscard]] constexpr const _NestedAccessor& nested_accessor() const noexcept { return __accessor_; }

private:
  _ScalingFactor __factor_{};
  _NestedAccessor __accessor_{};
};

template <class _ScalingFactor, class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto scaled(_ScalingFactor __factor, mdspan<_ElementType, _Extents, _Layout, _Accessor> __view) {
  using _AccessorType = scaled_accessor<_ScalingFactor, _Accessor>;
  using _Element      = typename _AccessorType::element_type;
  return mdspan<_Element, _Extents, _Layout, _AccessorType>(
      __view.data_handle(), __view.mapping(), _AccessorType{std::move(__factor), __view.accessor()});
}

template <class _NestedAccessor>
class conjugated_accessor {
public:
  using offset_policy = conjugated_accessor<typename _NestedAccessor::offset_policy>;
  using element_type =
      const remove_cvref_t<decltype(__detail::__conj_if_needed(declval<typename _NestedAccessor::element_type>()))>;
  // [linalg.conj.conjugatedaccessor]: as for scaled_accessor, reference drops
  // the const.
  using reference        = remove_const_t<element_type>;
  using data_handle_type = typename _NestedAccessor::data_handle_type;

  static_assert(!is_reference_v<element_type>, "conjugated_accessor element_type must not be a reference");
  static_assert(copy_constructible<reference>, "conjugated_accessor reference must be copy constructible");

  constexpr conjugated_accessor()
    requires default_initializable<_NestedAccessor>
  = default;
  // Not explicit: [linalg.conj.conjugatedaccessor] declares this converting
  // constructor without the explicit specifier.
  constexpr conjugated_accessor(const _NestedAccessor& __accessor) : __accessor_(__accessor) {}

  template <class _OtherNestedAccessor>
    requires constructible_from<_NestedAccessor, const _OtherNestedAccessor&>
  constexpr explicit(!is_convertible_v<_OtherNestedAccessor, _NestedAccessor>)
      conjugated_accessor(const conjugated_accessor<_OtherNestedAccessor>& __other)
      : __accessor_(__other.nested_accessor()) {}

  constexpr reference access(data_handle_type __handle, size_t __index) const {
    return __detail::__conj_if_needed(__accessor_.access(__handle, __index));
  }

  constexpr typename offset_policy::data_handle_type offset(data_handle_type __handle, size_t __index) const {
    return __accessor_.offset(__handle, __index);
  }

  [[nodiscard]] constexpr const _NestedAccessor& nested_accessor() const noexcept { return __accessor_; }

private:
  _NestedAccessor __accessor_{};
};

namespace __detail {
template <class _Accessor>
struct __conjugated_accessor_or_self {
  using type = conjugated_accessor<_Accessor>;
};

template <class _Accessor>
inline constexpr bool __is_conjugated_accessor_v = false;

template <class _NestedAccessor>
struct __conjugated_accessor_or_self<conjugated_accessor<_NestedAccessor>> {
  using type = _NestedAccessor;
};

template <class _NestedAccessor>
inline constexpr bool __is_conjugated_accessor_v<conjugated_accessor<_NestedAccessor>> = true;
} // namespace __detail

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto conjugated(mdspan<_ElementType, _Extents, _Layout, _Accessor> __view) {
  if constexpr (__detail::__is_conjugated_accessor_v<_Accessor>) {
    using _AccessorType = typename __detail::__conjugated_accessor_or_self<_Accessor>::type;
    using _Element      = typename _AccessorType::element_type;
    return mdspan<_Element, _Extents, _Layout, _AccessorType>(
        __view.data_handle(), __view.mapping(), __view.accessor().nested_accessor());
  } else if constexpr (!__detail::__has_adl_conj<_ElementType>) {
    // P3050R2: conjugation is a no-op for element types that are arithmetic, or for
    // which conj(E) isn't a valid expression -- don't wrap in a conjugated_accessor.
    return __view;
  } else {
    using _AccessorType = conjugated_accessor<_Accessor>;
    using _Element      = typename _AccessorType::element_type;
    return mdspan<_Element, _Extents, _Layout, _AccessorType>(
        __view.data_handle(), __view.mapping(), _AccessorType{__view.accessor()});
  }
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto transposed(mdspan<_ElementType, _Extents, _Layout, _Accessor> __view) {
  static_assert(_Extents::rank() == 2, "linalg::transposed requires a rank-two mdspan");

  using _ExtentsType = __detail::__transpose_extents_t<_Extents>;
  const _ExtentsType __extents{__view.extent(1), __view.extent(0)};

  if constexpr (same_as<_Layout, layout_left>) {
    using _Result = mdspan<_ElementType, _ExtentsType, layout_right, _Accessor>;
    return _Result{
        __view.data_handle(), typename layout_right::template mapping<_ExtentsType>{__extents}, __view.accessor()};
  } else if constexpr (same_as<_Layout, layout_right>) {
    using _Result = mdspan<_ElementType, _ExtentsType, layout_left, _Accessor>;
    return _Result{
        __view.data_handle(), typename layout_left::template mapping<_ExtentsType>{__extents}, __view.accessor()};
  } else if constexpr (same_as<_Layout, layout_stride>) {
    using _Mapping = typename layout_stride::template mapping<_ExtentsType>;
    using _Result  = mdspan<_ElementType, _ExtentsType, layout_stride, _Accessor>;
    const array<typename _Extents::index_type, 2> __strides{__view.mapping().stride(1), __view.mapping().stride(0)};
    return _Result{__view.data_handle(), _Mapping{__extents, __strides}, __view.accessor()};
  } else if constexpr (__detail::__is_layout_left_padded_v<_Layout>) {
    using _ReturnLayout = layout_right_padded<__detail::__is_layout_left_padded<_Layout>::value_padding>;
    using _Result = mdspan<_ElementType, _ExtentsType, _ReturnLayout, _Accessor>;
    return _Result{__view.data_handle(), typename _ReturnLayout::template mapping<_ExtentsType>{
        __extents, __view.mapping().stride(1)}, __view.accessor()};
  } else if constexpr (__detail::__is_layout_right_padded_v<_Layout>) {
    using _ReturnLayout = layout_left_padded<__detail::__is_layout_right_padded<_Layout>::value_padding>;
    using _Result = mdspan<_ElementType, _ExtentsType, _ReturnLayout, _Accessor>;
    return _Result{__view.data_handle(), typename _ReturnLayout::template mapping<_ExtentsType>{
        __extents, __view.mapping().stride(0)}, __view.accessor()};
  } else if constexpr (__detail::__is_layout_blas_packed_v<_Layout>) {
    using _Triangle =
        conditional_t<same_as<typename _Layout::triangle_type, upper_triangle_t>, lower_triangle_t, upper_triangle_t>;
    using _StorageOrder =
        conditional_t<same_as<typename _Layout::storage_order_type, column_major_t>, row_major_t, column_major_t>;
    using _ReturnLayout = layout_blas_packed<_Triangle, _StorageOrder>;
    using _Result       = mdspan<_ElementType, _ExtentsType, _ReturnLayout, _Accessor>;
    return _Result{
        __view.data_handle(), typename _ReturnLayout::template mapping<_ExtentsType>{__extents}, __view.accessor()};
  } else if constexpr (__detail::__is_layout_transpose_v<_Layout>) {
    using _ReturnLayout = typename __detail::__is_layout_transpose<_Layout>::type;
    using _Result       = mdspan<_ElementType, _ExtentsType, _ReturnLayout, _Accessor>;
    return _Result{__view.data_handle(), __view.mapping().nested_mapping(), __view.accessor()};
  } else {
    using _ReturnLayout = layout_transpose<_Layout>;
    using _Mapping      = typename _ReturnLayout::template mapping<_ExtentsType>;
    using _Result       = mdspan<_ElementType, _ExtentsType, _ReturnLayout, _Accessor>;
    return _Result{__view.data_handle(), _Mapping{__view.mapping()}, __view.accessor()};
  }
}

template <class _ElementType, class _Extents, class _Layout, class _Accessor>
constexpr auto conjugate_transposed(mdspan<_ElementType, _Extents, _Layout, _Accessor> __view) {
  return conjugated(transposed(__view));
}

