#ifndef _LIBCPP_NET
#define _LIBCPP_NET

/*
    net synopsis

    Stage Two of the networking series (platform I/O): addresses, endpoints, TCP sockets and acceptors, Unix domain
    stream sockets, the DNS resolver, UDP sockets and Unix domain datagram sockets. Experimental: the header is
    available in C++29 mode with -fexperimental-library only, on a platform that has a backend (Linux: epoll, macOS and
    FreeBSD: kqueue) and the BSD socket API, and needs thread support; otherwise it is empty.
    Provisional specification: P4100R1 [8.9] and the Corosio library (no WG21 paper yet). The names are in std::io so
    that the sockets sit next to the stream concepts of <io_stream>.

namespace std::io {
  enum class family { v4, v6 };
  enum shutdown_type { shutdown_receive, shutdown_send, shutdown_both };

  class ipv4_address;       // value type; make_ipv4_address(string_view) -> io_result<ipv4_address>
  class ipv6_address;       // value type with a zone; make_ipv6_address(string_view)
  class ip_address;         // either of the two; make_ip_address(string_view)
  class endpoint;           // ip_address and port; make_endpoint(string_view)
  class local_endpoint;     // a Unix domain socket path; make_local_endpoint(string_view)

  namespace socket_option {
    reuse_address, reuse_port, no_delay, keep_alive, v6_only, receive_buffer_size, send_buffer_size, linger,
    broadcast, multicast_loop, multicast_hops, join_group, leave_group
  }

  class tcp_socket;         // satisfies Stream; connect, read_some, write_some, shutdown, cancel, close, options
  class tcp_acceptor;       // open, bind, listen, accept, cancel, close
  class local_stream_socket;
  class local_stream_acceptor;

  enum class resolve_flags, reverse_flags;     // flag sets of the lookups
  enum class resolver_error;                   // the failures of the name service (resolver_category())
  class resolver_entry, resolver_results;      // a forward result: endpoint, host name, service name
  class reverse_resolver_result;               // host_name(), service_name()
  class resolver;                              // resolve(host, service[, flags]), resolve(endpoint[, flags]), cancel
  io_result<string> host_name();               // the name of this machine

  // connect(socket, range-of-endpoints[, condition]) and connect(socket, first, last[, condition]): tries each endpoint
  // in order (tcp_socket, local_stream_socket, the datagram sockets)

  enum class message_flags;                    // none, peek, out_of_band, do_not_route
  class udp_socket;                            // open, bind, send_to, receive_from, connect/send/receive, options
  class local_datagram_socket;                 // the same for Unix domain datagrams, with local_endpoint
  error_code connect_pair(local_datagram_socket&, local_datagram_socket&);   // and for local_stream_socket
}
*/

#if __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
#  include <__cxx03/__config>
#else
#  include <__config>

#  if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#    pragma GCC system_header
#  endif

#  include <version>

#  include <__io/support/config.h>

#  if _LIBCPP_HAS_IO_SOCKETS

#    include <__net/connect.h>
#    include <__net/endpoint.h>
#    include <__net/family.h>
#    include <__net/ip_address.h>
#    include <__net/ipv4_address.h>
#    include <__net/ipv6_address.h>
#    include <__net/local_datagram_socket.h>
#    include <__net/local_endpoint.h>
#    include <__net/local_stream_acceptor.h>
#    include <__net/local_stream_socket.h>
#    include <__net/message_flags.h>
#    include <__net/resolver.h>
#    include <__net/resolver_error.h>
#    include <__net/socket_option.h>
#    include <__net/tcp_acceptor.h>
#    include <__net/tcp_socket.h>
#    include <__net/udp_socket.h>

#  endif // _LIBCPP_HAS_IO_SOCKETS

#endif // __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)

#endif // _LIBCPP_NET
