#ifndef _LIBCPP_SIMD
#define _LIBCPP_SIMD

#include <__config>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

// [simd], listed in dependency order. See the audit at
// https://claude.ai/code/artifact/ec199a8d-5630-4a21-a780-1b5aef8322ad for the clause-by-clause
// conformance notes behind this header set.
//
// TRAP: __simd/simd.h (the old monolithic prototype) and these headers both declare
// simd::basic_vec with different default template arguments -- never include both in one TU. That
// file has been retired; this is the only <simd> implementation now.
#include <__simd/vectorizable.h>
#include <__simd/abi.h>
#include <__simd/concepts.h>
#include <__simd/traits.h>
#include <__simd/flags.h>
