  module execution {
    // [exec], std::execution (P2300R10) submodules. Each header pulls in
    // symbols from several tightly-coupled siblings (e.g. completion_functions'
    // set_value_t/set_error_t are used throughout), so — matching this file's
    // existing `allocator`/`unique_temporary_buffer`/`high_resolution_clock`
    // precedent for the same shape of problem (see their own TODOs referencing
    // https://github.com/llvm/llvm-project/issues/120108) — every submodule here
    // re-exports everything it imports rather than hand-enumerating each
    // cross-header symbol, since the latter was verified (see this file's own
    // history) to under-export and produce "declaration must be imported"
    // errors under a real `-fmodules` build.
    module as_awaitable                   { header "__execution/as_awaitable.h" export * }
    module async_scope                    { header "__execution/async_scope.h" export * }
    module awaitable                      { header "__execution/awaitable.h" export * }
    module bulk                           { header "__execution/bulk.h" export * }
    module completion_functions           { header "__execution/completion_functions.h" export * }
    module completion_signatures          { header "__execution/completion_signatures.h" export * }
    module connect                        { header "__execution/connect.h" export * }
    module continues_on                   { header "__execution/continues_on.h" export * }
    module domain                         { header "__execution/domain.h" export * }
    module env                            { header "__execution/env.h" export * }
    module forwarding_query               { header "__execution/forwarding_query.h" export * }
    module fwd_env                        { header "__execution/fwd_env.h" export * }
    module get_allocator                  { header "__execution/get_allocator.h" export * }
    module get_completion_signatures      { header "__execution/get_completion_signatures.h" export * }
    module get_env                        { header "__execution/get_env.h" export * }
    module get_forward_progress_guarantee { header "__execution/get_forward_progress_guarantee.h" export * }
    module get_scheduler                  { header "__execution/get_scheduler.h" export * }
    module get_stop_token                 { header "__execution/get_stop_token.h" export * }
    module into_variant                   { header "__execution/into_variant.h" export * }
    module just                           { header "__execution/just.h" export * }
    module let                            { header "__execution/let.h" export * }
    module movable_value                  { header "__execution/movable_value.h" export * }
    module on                             { header "__execution/on.h" export * }
    module operation_state                { header "__execution/operation_state.h" export * }
    module parallel_scheduler             { header "__execution/parallel_scheduler.h" export * }
    module queryable                      { header "__execution/queryable.h" export * }
    module read_env                       { header "__execution/read_env.h" export * }
    module receiver                       { header "__execution/receiver.h" export * }
    module run_loop                       { header "__execution/run_loop.h" export * }
    module schedule                       { header "__execution/schedule.h" export * }
    module schedule_from                  { header "__execution/schedule_from.h" export * }
    module scheduler                      { header "__execution/scheduler.h" export * }
    module sender                         { header "__execution/sender.h" export * }
    module sender_adaptor_closure         { header "__execution/sender_adaptor_closure.h" export * }
    module starts_on                      { header "__execution/starts_on.h" export * }
    module stop_when                      { header "__execution/stop_when.h" export * }
    module stopped_as_error               { header "__execution/stopped_as_error.h" export * }
    module stopped_as_optional            { header "__execution/stopped_as_optional.h" export * }
    module sync_wait                      { header "__execution/sync_wait.h" export * }
    module task                           { header "__execution/task.h" export * }
    module task_scheduler                 { header "__execution/task_scheduler.h" export * }
    module then                           { header "__execution/then.h" export * }
