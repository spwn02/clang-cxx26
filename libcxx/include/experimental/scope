    class scope_fail;
  template <class EF>
    class scope_success;

  template <class R, class D>
    class unique_resource;

  template <class R, class D, class S = decay_t<R>>
    unique_resource<decay_t<R>, decay_t<D>>
      make_unique_resource_checked(R&& r, const S& invalid, D&& d) noexcept(see below);

