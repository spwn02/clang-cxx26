class _LIBCPP_EXPORTED_FROM_ABI logic_error : public exception {
#  ifndef _LIBCPP_ABI_VCRUNTIME

private:
  std::__libcpp_refstring __imp_;

public:
#  if defined(_LIBCPP_STDEXCEPT_DEFINE_LEGACY_FUNCTIONS)
  explicit logic_error(const string&);
  explicit logic_error(const char*);

  logic_error(const logic_error&) _NOEXCEPT;
  logic_error& operator=(const logic_error&) _NOEXCEPT;

  ~logic_error() _NOEXCEPT override;

  [[__nodiscard__]] const char* what() const _NOEXCEPT override;
#  else
#    if _LIBCPP_STD_VER >= 26
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 explicit logic_error(const string&);
#    else
  explicit logic_error(const string&);
#    endif
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 explicit logic_error(const char* __msg) : __imp_(__msg) {}
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 logic_error(const logic_error&) _NOEXCEPT = default;
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 logic_error& operator=(const logic_error&) _NOEXCEPT = default;
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 ~logic_error() _NOEXCEPT override {}
  [[__nodiscard__]] _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 const char* what() const _NOEXCEPT override {
    return __imp_.c_str();
  }
#  endif
#  else

public:
  explicit logic_error(const std::string&); // Symbol uses versioned std::string
  _LIBCPP_HIDE_FROM_ABI explicit logic_error(const char* __s) : exception(__s) {}
#  endif
};

