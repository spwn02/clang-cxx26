#  ifndef _LIBCPP_ABI_VCRUNTIME
class __libcpp_refstring;

// These are deliberately exported implementation details.  C++26 headers
// inline the constexpr-facing exception members, but their ordinary runtime
// path must retain the old refcounted representation in libc++.  Keeping that
// code here, behind these calls, also leaves the pre-C++26 out-of-line
// logic_error/runtime_error symbols available to already-compiled clients.
_LIBCPP_EXPORTED_FROM_ABI void __libcpp_refstring_init(__libcpp_refstring&, const char*);
_LIBCPP_EXPORTED_FROM_ABI void __libcpp_refstring_copy(__libcpp_refstring&, const __libcpp_refstring&) _NOEXCEPT;
_LIBCPP_EXPORTED_FROM_ABI void __libcpp_refstring_assign(__libcpp_refstring&, const __libcpp_refstring&) _NOEXCEPT;
_LIBCPP_EXPORTED_FROM_ABI void __libcpp_refstring_destroy(__libcpp_refstring&) _NOEXCEPT;

class _LIBCPP_HIDDEN __libcpp_refstring {
  const char* __imp_;

  friend void __libcpp_refstring_init(__libcpp_refstring&, const char*);
  friend void __libcpp_refstring_copy(__libcpp_refstring&, const __libcpp_refstring&) _NOEXCEPT;
  friend void __libcpp_refstring_assign(__libcpp_refstring&, const __libcpp_refstring&) _NOEXCEPT;
  friend void __libcpp_refstring_destroy(__libcpp_refstring&) _NOEXCEPT;

#    if defined(_LIBCPP_STDEXCEPT_DEFINE_LEGACY_FUNCTIONS)
  bool __uses_refcount() const;

public:
  explicit __libcpp_refstring(const char* __msg);
  __libcpp_refstring(const __libcpp_refstring& __s) _NOEXCEPT;
  __libcpp_refstring& operator=(const __libcpp_refstring& __s) _NOEXCEPT;
  ~__libcpp_refstring();

  _LIBCPP_HIDE_FROM_ABI const char* c_str() const _NOEXCEPT { return __imp_; }
#    else
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 void __init_consteval(const char* __msg) {
    size_t __n = 0;
    while (__msg[__n] != '\0')
      ++__n;
    char* __copy = new char[__n + 1];
    for (size_t __i = 0; __i != __n + 1; ++__i)
      __copy[__i] = __msg[__i];
    __imp_ = __copy;
  }

public:
  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 explicit __libcpp_refstring(const char* __msg) {
#      if _LIBCPP_STD_VER >= 26
    if consteval {
      __init_consteval(__msg);
      return;
    }
#      endif
    __libcpp_refstring_init(*this, __msg);
  }

  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 __libcpp_refstring(const __libcpp_refstring& __s) _NOEXCEPT {
#      if _LIBCPP_STD_VER >= 26
    if consteval {
      __init_consteval(__s.__imp_);
      return;
    }
#      endif
    __libcpp_refstring_copy(*this, __s);
  }

  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 __libcpp_refstring&
  operator=(const __libcpp_refstring& __s) _NOEXCEPT {
    if (this == &__s)
      return *this;
#      if _LIBCPP_STD_VER >= 26
    if consteval {
      delete[] __imp_;
      __init_consteval(__s.__imp_);
      return *this;
    }
#      endif
    __libcpp_refstring_assign(*this, __s);
    return *this;
  }

  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 ~__libcpp_refstring() {
#      if _LIBCPP_STD_VER >= 26
    if consteval {
      delete[] __imp_;
      return;
    }
#      endif
    __libcpp_refstring_destroy(*this);
  }

  _LIBCPP_HIDE_FROM_ABI _LIBCPP_CONSTEXPR_SINCE_CXX26 const char* c_str() const _NOEXCEPT { return __imp_; }
#    endif // defined(_LIBCPP_STDEXCEPT_DEFINE_LEGACY_FUNCTIONS)
};
#  endif // !_LIBCPP_ABI_VCRUNTIME

_LIBCPP_END_NAMESPACE_STD

