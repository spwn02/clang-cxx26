                    // ====================================
                    // (u8)display_string_of implementation
                    // ====================================

// For the sake of compile-times, this probably would be better off being
// implemented as an intrinsic - but it ought to be possible to use CXX26 to
// implement something like it, and the exercise of implementing it as a
// library has revealed both gaps in the paper and bugs in the implementation.
//
// For now, seeing as CXX26 Clang is still first and foremost a prototype, the
// implementation stands as both a "test" of the power of the APIs proposed by
// the paper, and a demonstratation of some reflection techniques.

namespace __detail {

template <typename _CharT>
struct pretty_printer {
  static_assert(__detail::__underlying_entity_of(^^_CharT) == ^^char ||
                __detail::__underlying_entity_of(^^_CharT) == ^^char8_t);
  static constexpr bool IsUtf8 = is_same_type(^^_CharT, ^^char8_t);

  using __string_t _LIBCPP_NODEBUG = basic_string<_CharT>;

  static consteval const _CharT *string_constant(string_view __contents) {
    if constexpr (IsUtf8) {
      u8string __result(__contents.size(), 0);
      for (size_t __idx = 0; char __c : __contents)
        __result[__idx++] = char8_t(__c);

      return std::define_static_string(__result);
    } else {
      return __contents.data();
    }
  }

  static consteval auto identifier_helper(info __r) {
    if constexpr (IsUtf8)
      return u8identifier_of(__r);
    else
      return identifier_of(__r);
  }

  static consteval auto operator_symbol_helper(operators __op) {
    if constexpr (IsUtf8)
      return u8symbol_of(__op);
    else
      return symbol_of(__op);
  }

  template <info _Rp>
  static consteval info type_of_object_from_memptr() {
    return []<typename _Tp,
              typename _Cp>(_Tp _Cp::*) { return ^^_Cp; }(typename [:_Rp:]{});
  };

  template <info _Rp>
  static consteval info type_of_member_from_memptr() {
    return []<typename _Tp,
              typename _Cp>(_Tp _Cp::*) { return ^^_Tp; }(typename [:_Rp:]{});
  };

  template<auto... _Vals>
  struct replicator_type {
    template<typename _Fp>
      constexpr void operator>>(_Fp __body) const {
        (__body.template operator()<_Vals>(), ...);
      }
  };

  template<auto... _Vals>
  static constexpr replicator_type<_Vals...> replicator = {};

  template<typename _Rp>
  static consteval auto expand(_Rp __range) {
    vector<info> __args;
    for (auto __r : __range) {
      __args.push_back(meta::reflect_constant(__r));
    }
    return meta::substitute(^^replicator, __args);
  }

  template <info _Rp>
      requires (has_template_arguments(_Rp))
    static consteval __string_t render_template_argument_list_of();

  template <info _Rp>
      requires (is_value(_Rp))
    static consteval __string_t render_value_as_hex();

  template <info _Rp>
    static consteval const _CharT *tprint();

  struct tprint_impl {
    template <info _Rp>  // Null reflection.
        requires (_Rp == info{})
      static consteval __string_t render() {
        return string_constant("(null-reflection)");
      }

    template <info _Rp>  // Values of fundamental type.
        requires (is_value(_Rp) && is_fundamental_type(type_of(_Rp)))
      static consteval __string_t render();

    template <info _Rp>  // Values of aggregate type.
        requires (is_value(_Rp) && is_aggregate_type(type_of(_Rp)))
      static consteval __string_t render();

    template <info _Rp>  // Values of pointer type.
        requires (is_value(_Rp) && is_pointer_type(type_of(_Rp)))
      static consteval __string_t render();

    template <info _Rp>  // Objects.
        requires (is_object(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Variables, data members, enumerators.
        requires (is_variable(_Rp) || is_nonstatic_data_member(_Rp) ||
                  is_enumerator(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Templates.
        requires (is_template(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Namespaces.
        requires (is_namespace(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Functions.
        requires (is_function(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Value types.
        requires (is_type(_Rp) && !(is_const(_Rp) || is_volatile(_Rp)) &&
                  !is_pointer_type(_Rp) && !is_array_type(_Rp) &&
                  !is_function_type(_Rp) && !is_reference_type(_Rp) &&
                  !is_member_pointer_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // CV-qualified non-function, non-arry types.
        requires (is_type(_Rp) && (is_const(_Rp) || is_volatile(_Rp)) &&
                  !is_array_type(_Rp) && !is_function_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Reference types.
        requires (is_type(_Rp) && !(is_const(_Rp) || is_volatile(_Rp)) &&
                  is_reference_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Unqualified array types.
        requires (is_type(_Rp) && is_array_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Function types.
        requires (is_type(_Rp) && is_function_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Non-function, non-member pointer types.
        requires (is_type(_Rp) && is_pointer_type(_Rp) &&
                  !(is_const(_Rp) || is_volatile(_Rp)) &&
                  !is_function_type(remove_pointer(_Rp)))
      static consteval __string_t render();

    template <info _Rp>  // Function pointer types.
        requires (is_type(_Rp) && is_pointer_type(_Rp) &&
                  is_function_type(remove_pointer(_Rp)))
      static consteval __string_t render();

    template <info _Rp>  // Pointer to data member types.
        requires (is_type(_Rp) && is_member_pointer_type(_Rp) &&
                  !(is_const(_Rp) || is_volatile(_Rp)) &&
                  !is_member_function_pointer_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Pointer to member function types.
        requires (is_type(_Rp) && is_member_function_pointer_type(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Base specifiers.
        requires (is_base(_Rp))
      static consteval __string_t render();

    template <info _Rp>  // Fallback.
      static consteval __string_t render();
  };

  static consteval const _CharT *print(info __r);

  friend consteval auto display_string_of(info) -> string_view;
  friend consteval auto u8display_string_of(info) -> u8string_view;

};

template <typename _CharT>
consteval auto pretty_printer<_CharT>::print(info __r)
      -> const _CharT * {
  return meta::extract<const _CharT *>(__reflect_invoke(^^tprint,
                                               {reflect_constant(__r)}, {}));
}

template <typename _CharT>
template <info _Rp>
    requires (has_template_arguments(_Rp))
consteval auto pretty_printer<_CharT>::render_template_argument_list_of()
      -> __string_t {
  __string_t __result;

  if (template_arguments_of(_Rp).empty())
    return string_constant("<>");

  size_t __idx = 0;
  [:expand(template_arguments_of(_Rp)):] >> [&]<auto _TArg> {
    __result += (__idx++ < 1 ? string_constant("<") : string_constant(", "));
    __result += tprint_impl::template render<_TArg>();
  };
  return __result + string_constant(">");
}

template <typename _CharT>
template <info _Rp>
    requires (is_value(_Rp))
consteval auto pretty_printer<_CharT>::render_value_as_hex() -> __string_t {
  __string_t __result = string_constant("0x");

  auto __bytes = std::bit_cast<array<unsigned char, size_of(type_of(_Rp))>>([:_Rp:]);
  if (endian::native == endian::little)
    std::reverse(begin(__bytes), end(__bytes));

  for (auto __b : __bytes) {
    static constexpr char __lookup[] = "0123456789ABCDEF";
    __result += __lookup[(__b & _CharT(0xF0)) >> 4];
    __result += __lookup[__b & _CharT(0x0F)];
  }

  return __result;
}

template <typename _CharT>
template <info _Rp>
consteval auto pretty_printer<_CharT>::tprint() -> const _CharT * {
  return std::define_static_string(tprint_impl::template render<_Rp>());
}

template <typename _CharT>
template <info _Rp>  // Values of fundamental type.
    requires(is_value(_Rp) && is_fundamental_type(type_of(_Rp)))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result;
  constexpr info __ty = __detail::__underlying_entity_of(type_of(_Rp));

  if constexpr (__ty == ^^nullptr_t)
    __result = string_constant("nullptr");

  if constexpr (is_same_type(__ty, ^^bool)) {
    if (extract<bool>(_Rp))
      __result = string_constant("true");
    else
      __result = string_constant("false");
  }

  else if constexpr (is_same_type(__ty, ^^char)) {
    __result = string_constant("'");
    __result.append(1, extract<char>(_Rp));
    __result += string_constant("'");
  }

  else if constexpr (is_integral_type(__ty) &&
                     __detail::__underlying_entity_of(^^_CharT) == ^^char) {
    _CharT __buffer[32] = {};
    if (!std::to_chars(begin(__buffer), end(__buffer), [:_Rp:]))
      throw "'to_chars' failed to format integeral value";
    __result = __buffer;
  }

  else if constexpr (is_floating_point_type(__ty)) {
    __result = render_value_as_hex<_Rp>();
  }

  else {
    __result += string_constant("(value : ");
    __result += render<__ty>();
    __result += string_constant(")");
  }

  return __result;
}

template <typename _CharT>
template <info _Rp>  // Values of aggregate type.
    requires(is_value(_Rp) && is_aggregate_type(type_of(_Rp)))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result = render<type_of(_Rp)>() + string_constant("{");

  size_t __idx = 0;
  [:expand(nonstatic_data_members_of(type_of(_Rp),
                                     access_context::unchecked())):] >>
      [&]<auto _Mem> {
        if (__idx++ > 0) __result += string_constant(", ");
          __result += tprint_impl::render<meta::reflect_constant([:_Rp:].[:_Mem:])>();
      };
  __result += string_constant("}");

  return __result;
}

template <typename _CharT>
template <info _Rp>  // Values of pointer type.
    requires (is_value(_Rp) && is_pointer_type(type_of(_Rp)))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  return string_constant("(value : ") + render<type_of(_Rp)>() +
         string_constant(")");
}

template <typename _CharT>
template <info _Rp>  // Objects.
    requires (is_object(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result = string_constant("(object : ");
  __result += render<type_of(_Rp)>();
  return __result + string_constant(")");
}

template <typename _CharT>
template <info _Rp>  // Templates.
    requires(is_template(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  if constexpr (is_constructor_template(_Rp))
    return render<parent_of(_Rp)>();
  else if (is_operator_function_template(_Rp)) {
    operators __op = operator_of(_Rp);

    __string_t __result = "operator";
    switch (__op) {
    case operators::op_new:
    case operators::op_delete:
    case operators::op_array_new:
    case operators::op_array_delete:
    case operators::op_co_await:
      __result += " ";
      [[fallthrough]];
    default:
      return __result + operator_symbol_helper(__op);
    }
  } else if (is_conversion_function_template(_Rp))
    return string_constant("(conversion-function-template)");
  else if (is_literal_operator_template(_Rp))
    return string_constant(R"(operator"")") + __string_t {identifier_helper(_Rp) };

  return __string_t {identifier_helper(_Rp)};
}

template <typename _CharT>
template <info _Rp>  // Namespaces.
    requires(is_namespace(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  if (_Rp == ^^::)
    return string_constant("(global-namespace)");
  if (!has_identifier(_Rp))
    return string_constant("(anonymous-namespace)");

  return __string_t {identifier_helper(_Rp)};
}

template <typename _CharT>
template <info _Rp>  // Functions.
    requires(is_function(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result;

  if constexpr (has_template_arguments(_Rp)) {
    return render<template_of(_Rp)>() + render_template_argument_list_of<_Rp>();
  } else if constexpr (is_destructor(_Rp)) {
    constexpr info __p = parent_of(_Rp);
    return string_constant("~") +
           render<has_template_arguments(__p) ? template_of(__p) : __p>();
  } else if constexpr (is_constructor(_Rp)) {
    return render<parent_of(_Rp)>();
  } else if constexpr (is_operator_function(_Rp)) {
    operators __op = operator_of(_Rp);

    __result = "operator";
    switch (__op) {
    case operators::op_new:
    case operators::op_delete:
    case operators::op_array_new:
    case operators::op_array_delete:
    case operators::op_co_await:
      __result += " ";
      [[fallthrough]];
    default:
      return __result + operator_symbol_helper(__op);
    }
  } else if constexpr (is_conversion_function(_Rp)) {
#if __has_feature(parameter_reflection)
    return string_constant("operator ") + render<return_type_of(_Rp)>();
#else
    return string_constant("conversion-function");
#endif
  } else if constexpr (is_literal_operator(_Rp)) {
    return string_constant(R"(operator"")") + __string_t {identifier_helper(_Rp) };
  }

  return __string_t {identifier_helper(_Rp)};
}

template <typename _CharT>
template <info _Rp>  // Value types.
    requires (is_type(_Rp) && !(is_const(_Rp) || is_volatile(_Rp)) &&
              !is_pointer_type(_Rp) && !is_array_type(_Rp) &&
              !is_function_type(_Rp) && !is_reference_type(_Rp) &&
              !is_member_pointer_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result;

  if constexpr (has_template_arguments(_Rp)) {
    return render<template_of(_Rp)>() + render_template_argument_list_of<_Rp>();
  } else if constexpr (is_fundamental_type(_Rp)) {
    if (_Rp == ^^void) return string_constant("void");

    if (_Rp == ^^decltype(nullptr) || _Rp == ^^nullptr_t)
      return string_constant("std::nullptr_t");
    if (_Rp == ^^info || _Rp == __detail::__underlying_entity_of(^^info))
      return string_constant("std::meta::info");

    if (_Rp == ^^bool) return string_constant("bool");
    if (_Rp == ^^signed char) return string_constant("signed char");
    if (_Rp == ^^unsigned char) return string_constant("unsigned char");
    if (_Rp == ^^char) return string_constant("char");

    if (_Rp == ^^char8_t) return string_constant("char8_t");
    if (_Rp == ^^char16_t) return string_constant("char16_t");
    if (_Rp == ^^char32_t) return string_constant("char32_t");

    if (_Rp == ^^float) return string_constant("float");
    if (_Rp == ^^double) return string_constant("double");
    if (_Rp == ^^long double) return string_constant("long double");

    if (is_unsigned_type(_Rp)) __result += string_constant("unsigned ");
    if constexpr (!is_type_alias(_Rp)) {
      auto __u = make_signed(_Rp);
      if (__u == ^^short) return __result + string_constant("short");
      if (__u == ^^int) return __result + string_constant("int");
      if (__u == ^^long) return __result + string_constant("long");
      if (__u == ^^long long) return __result + string_constant("long long");
    }
  }

  if (has_identifier(_Rp)) {
    return __string_t {identifier_helper(_Rp)};
  } else {
    return string_constant("(anonymous type)");
  }
}

template <typename _CharT>
template <info _Rp>  // CV-qualified non-function, non-array types.
    requires (is_type(_Rp) && (is_const(_Rp) || is_volatile(_Rp)) &&
              !is_array_type(_Rp) && !is_function_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result;
  if (is_const(_Rp))
    __result += string_constant("const ");
  if (is_volatile(_Rp))
    __result += string_constant("volatile ");
  return __result + render<remove_cv(_Rp)>();
}

template <typename _CharT>
template <info _Rp>  // Reference types.
    requires (is_type(_Rp) && !(is_const(_Rp) || is_volatile(_Rp)) &&
              is_reference_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result = render<remove_reference(_Rp)>() + string_constant(" &");
  if (is_rvalue_reference_type(_Rp))
    __result += string_constant("&");
  return __result;
}

template <typename _CharT>
template <info _Rp>  // Array types.
    requires (is_type(_Rp) && is_array_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result = render<remove_all_extents(_Rp)>();

  for (size_t __k = 0; __k < rank(_Rp); ++__k) {
    _CharT __buffer[32] = {};
    if (!std::to_chars(begin(__buffer), end(__buffer), extent(_Rp, __k)))
      throw "'to_chars' failed to format integeral value";

    __result += "[" + __string_t {__buffer} + "]";
  }
  return __result;
}

template <typename _CharT>
template <info _Rp>  // Non-function, non-member pointer types.
    requires (is_type(_Rp) && is_pointer_type(_Rp) &&
              !(is_const(_Rp) || is_volatile(_Rp)) &&
              !is_function_type(remove_pointer(_Rp)))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  return render<remove_pointer(_Rp)>() + string_constant(" *");
}

template <typename _CharT>
template <info _Rp>  // Function pointers.
    requires (is_type(_Rp) && is_pointer_type(_Rp) &&
              is_function_type(remove_pointer(_Rp)))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {

#if __has_feature(parameter_reflection)
  constexpr auto __fn_ty = remove_pointer(_Rp);
  __string_t __result = render<return_type_of(__fn_ty)>() + string_constant("(*)(");
  size_t __idx = 0;
  [:expand(parameters_of(__fn_ty)):] >> [&]<auto _Param> {
    if (__idx++ > 0) __result += string_constant(", ");
    __result += tprint_impl::render<_Param>();
  };
  __result += string_constant(")");

  if (is_noexcept(__fn_ty))
    __result += string_constant(" noexcept");
#else
  __string_t result = string_constant("(function-pointer-type)");
#endif

  return __result;
}

template <typename _CharT>
template <info _Rp>  // Function types.
    requires (is_type(_Rp) && is_function_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
#if __has_feature(parameter_reflection)
  __string_t __result = render<return_type_of(_Rp)>() + string_constant("(");
  size_t __idx = 0;
  [:expand(parameters_of(_Rp)):] >> [&]<auto _Param> {
    if (__idx++ > 0) __result += string_constant(", ");
    __result += tprint_impl::render<_Param>();
  };
  __result += string_constant(")");

  if (is_const(_Rp))
    __result += string_constant(" const");
  if (is_volatile(_Rp))
    __result += string_constant(" volatile");

  if (is_lvalue_reference_qualified(_Rp))
    __result += string_constant(" &");
  else if (is_rvalue_reference_qualified(_Rp))
    __result += string_constant(" &&");

  if (is_noexcept(_Rp))
    __result += string_constant(" noexcept");
#else
  __string_t result = string_constant("(function-type)");
#endif

  return __result;
}

template <typename _CharT>
template <info _Rp>  // Pointer to data member types.
    requires (is_type(_Rp) && is_member_pointer_type(_Rp) &&
              !(is_const(_Rp) || is_volatile(_Rp)) &&
              !is_member_function_pointer_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  __string_t __result = render<type_of_member_from_memptr<_Rp>()>() +
                    string_constant(" ");
  __result += render<type_of_object_from_memptr<_Rp>()>() + string_constant("::*");

  return __result;
}

template <typename _CharT>
template <info _Rp>  // Pointer to member function types.
    requires (is_type(_Rp) && is_member_function_pointer_type(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  constexpr auto __fn_ty = type_of_member_from_memptr<_Rp>();

#if __has_feature(parameter_reflection)
  __string_t __result = render<meta::return_type_of(__fn_ty)>() + string_constant("(");
  __result += render<type_of_object_from_memptr<_Rp>()>() +
            string_constant("::*)(");

  size_t __idx = 0;
  [:expand(meta::parameters_of(__fn_ty)):] >> [&]<auto _Param> {
    if (__idx++ > 0) __result += string_constant(", ");
    __result += tprint_impl::render<_Param>();
  };
  __result += string_constant(")");

  if (meta::is_const(__fn_ty))
    __result += string_constant(" const");
  if (meta::is_volatile(__fn_ty))
    __result += string_constant(" volatile");

  if (meta::is_lvalue_reference_qualified(__fn_ty))
    __result += string_constant(" &");
  else if (meta::is_rvalue_reference_qualified(__fn_ty))
    __result += string_constant(" &&");

  if (meta::is_noexcept(__fn_ty))
    __result += string_constant(" noexcept");
#else
  __string_t result = string_constant("(member-function-pointer-type)");
#endif

  return __result;
}


template <typename _CharT>
template <info _Rp>  // Base specifiers.
    requires (is_base(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  return __string_t {render<type_of(_Rp)>()};
}

template <typename _CharT>
template <info _Rp>  // Fallback.
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  return string_constant("(unsupported-reflection)");
}

template <typename _CharT>
template <info _Rp>  // Variables, data members, enumerators.
    requires (is_variable(_Rp) || is_nonstatic_data_member(_Rp) || is_enumerator(_Rp))
consteval auto pretty_printer<_CharT>::tprint_impl::render() -> __string_t {
  if constexpr (has_identifier(_Rp))
    return __string_t {identifier_helper(_Rp)};
  else
    return string_constant("(unnamed-member)");
}
}  // namespace __detail

consteval auto display_string_of(info __r) -> string_view {
  return __detail::pretty_printer<char>::print(__r);
}

consteval auto u8display_string_of(info __r) -> u8string_view {
  return __detail::pretty_printer<char8_t>::print(__r);
}

