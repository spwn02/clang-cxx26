// Representation of a data member which may be passed to 'data_member_spec'.
struct data_member_options {
  struct __name_type {
    bool __is_u8;
    u8string __u8;
    string __s;

    template <typename _Tp> requires constructible_from<u8string, _Tp>
    consteval __name_type(_Tp &&__name) : __is_u8(true), __u8((_Tp&&)__name) {}

    template <typename _Tp> requires constructible_from<string, _Tp>
    consteval __name_type(_Tp &&__name) : __is_u8(false), __s((_Tp&&)__name) {}

    private:
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wunused-private-field"
      info __unused_ = ^^::;
#pragma clang diagnostic pop
  };

  optional<__name_type> name = nullopt;
  optional<int> alignment = nullopt;
  optional<int> bit_width = nullopt;
  bool no_unique_address = false;
  vector<info> annotations = {};
};


// Returns a reflection representing a description of a data member, which may
// be used with 'define_aggregate' to define a record type.
consteval auto data_member_spec(info __member_type,
                                data_member_options __options) -> info {
  if (!is_type(__member_type))
    throw __lib_exception(u8"member type must represent an object or reference type",
                    ^^data_member_spec,
                    source_location::current(__builtin_meta_call_origin()));
  __member_type = __detail::__underlying_entity_of(__member_type);
  if (!is_object_type(__member_type) && !is_reference_type(__member_type))
    throw __lib_exception(u8"member type must represent an object or reference type",
                    ^^data_member_spec,
                    source_location::current(__builtin_meta_call_origin()));

  bool __has_name = __options.name.has_value();
  int __alignment = __options.alignment.value_or(0);
  int __width = __options.bit_width.value_or(0);
  bool __no_unique_address = __options.no_unique_address;
  if (!__has_name && (!__options.bit_width.has_value() || !__options.annotations.empty()))
    throw __lib_exception(u8"unnamed member must be a bit-field without annotations",
                    ^^data_member_spec,
                    source_location::current(__builtin_meta_call_origin()));
  for (info& __annotation : __options.annotations) {
    // Annotation failures belong to data_member_spec, including failures in
    // type_of and constant_of. Store the value required by the description.
    info __type = __metafunction(__detail::__metafn_type_of, __annotation, ^^data_member_spec);
    if (!is_object_type(__type) || is_array_type(__type))
      throw __lib_exception(u8"__annotation must have non-array object __type",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    __annotation = __metafunction(__detail::__metafn_constant_of, __annotation, ^^data_member_spec);
  }

  if (__options.bit_width.has_value()) {
    if (!is_integral_type(__member_type) && !is_enum_type(__member_type))
      throw __lib_exception(u8"bit-field must have integral or enumeration type",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (__options.alignment.has_value())
      throw __lib_exception(u8"cannot specify both bit width and alignment",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (__no_unique_address)
      throw __lib_exception(u8"cannot specify both bit width and no_unique_address",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (__width < 0)
      throw __lib_exception(u8"bit width must not be negative",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (__width == 0 && __has_name)
      throw __lib_exception(u8"zero-width bit-field must be unnamed",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (!__has_name && (is_const(__member_type) || is_volatile(__member_type)))
      throw __lib_exception(u8"unnamed bit-field must not be cv-qualified",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
  }

  if (__options.alignment.has_value()) {
    if (__alignment <= 0 || ((__alignment - 1) & __alignment))
      throw __lib_exception(u8"alignment must be a positive power of two",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (!is_complete_type(__member_type))
      throw __lib_exception(u8"alignment requires a complete member type",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
    if (__alignment < int(alignment_of(__member_type)))
      throw __lib_exception(u8"alignment must not be less than that of the member type",
                      ^^data_member_spec,
                      source_location::current(__builtin_meta_call_origin()));
  }

  if (__has_name) {
    if (__options.name->__is_u8) {
      const u8string &__s = __options.name->__u8;
      return __metafunction(__detail::__metafn_data_member_spec,
                            __member_type,
                            true, __s.size(), ^^const char8_t, __s.data(),
                            __options.alignment.has_value(), __alignment,
                            __options.bit_width.has_value(), __width,
                            __no_unique_address,
                            __options.annotations.size(), __options.annotations.data(),
                            ^^data_member_spec);
    } else {
      const string &__s = __options.name->__s;
      return __metafunction(__detail::__metafn_data_member_spec,
                            __member_type,
                            true, __s.size(), ^^const char, __s.data(),
                            __options.alignment.has_value(), __alignment,
                            __options.bit_width.has_value(), __width,
                            __no_unique_address,
                            __options.annotations.size(), __options.annotations.data(),
                            ^^data_member_spec);
    }
  } else {
    return __metafunction(__detail::__metafn_data_member_spec,
      __member_type,
      false, 0, ^^const char, "",
      __options.alignment.has_value(), __alignment,
      __options.bit_width.has_value(), __width,
      __no_unique_address,
      __options.annotations.size(), __options.annotations.data(),
      ^^data_member_spec);
  }
}

