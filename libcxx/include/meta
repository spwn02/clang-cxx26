consteval auto __bases_of(info r, access_context ctx, info from) -> vector<info> {
  if (is_namespace(r))
    throw exception(u8"Namespaces cannot have base classes", from);

  using iterator =
    __range_of_infos::iterator<__range_of_infos::front_base_of_fn,
                                __range_of_infos::next_base_of_fn,
                                __range_of_infos::map_identity_fn>;
