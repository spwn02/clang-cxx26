// Whether 'T' can serve as 'range_value_t<R>' for 'reflect_constant_array'
// below. The ordinary (non-array) case needs 'ValTy' constructible from the
// range's actual reference type (see the constraint on the definition
// itself, further below, which also applies 'static_cast<ValTy>' per LWG
// 4432) -- but 'is_constructible_v<T, U>' is unconditionally false for any
// array type 'T' (an array object can never be direct-initialized via
// ordinary constructor syntax, so the trait is specified to be false
// regardless of 'U' in that case), so a nested-array row (CWG 3111) needs a
// different, recursive check instead: an array type is fine here as long as
// its element type is, all the way down to whatever scalar/class type
// bottoms out the nesting, and that bottom type is copy-constructible (what
// '__reflect_array_object' needs in order to copy it into the array's
// template parameter object).
template <typename T>
inline constexpr bool __reflect_constant_array_row_ok_v = is_copy_constructible_v<T>;
template <typename T, size_t N>
inline constexpr bool __reflect_constant_array_row_ok_v<T[N]> =
    __reflect_constant_array_row_ok_v<T>;

// 'range_value_t<R>' is an array for the nested-array extension above, but
// arrays themselves are not structural types even when every ultimate leaf
// is. Apply P3491's structural mandate to the element that is actually made
// into a template argument, recursively through those implementation rows.
template <typename T>
inline constexpr bool __reflect_constant_array_structural_v = is_structural_type(^^T);
template <typename T, size_t N>
inline constexpr bool __reflect_constant_array_structural_v<T[N]> =
    __reflect_constant_array_structural_v<T>;

// Reflects the canonical array template parameter object for converted,
// contiguous leaf values in row-major order. Extents must be nonzero and their
// product must equal count. Empty arrays are handled separately by the library.
template <typename T>
consteval info __reflect_array_object(const size_t* dims, size_t rank,
                                      const T* data, size_t count) {
  return __metafunction(detail::__metafn_reflect_array_object, ^^T,
                        dims, rank, data, count, ^^__reflect_array_object<T>);
}

// Returns a reflection of the value held by the provided argument.
template <typename T>
consteval auto reflect_constant(T r) -> info {
  static_assert(is_copy_constructible_v<T>, "reflect_constant requires a copy-constructible type");
  static_assert(is_same_v<T, remove_cv_t<T>> && !is_reference_v<T> && is_structural_type(^^T),
                "reflect_constant requires a cv-unqualified structural non-reference type");
  if constexpr (is_copy_constructible_v<T> && is_same_v<T, remove_cv_t<T>> &&
                !is_reference_v<T> && is_structural_type(^^T))
    return __metafunction(detail::__metafn_reflect_result, ^^T, r, ^^reflect_constant<T>);
  else
    return {};
}

