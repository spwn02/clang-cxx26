// Validate before the internal builder: invalid template arguments must throw
// meta::exception, including pointer members of structural class leaves.
template <class _Leaf, class _Tp>
consteval void __append_leaves(vector<_Leaf>& __values, const _Tp& __value) {
  if constexpr (is_array_v<_Tp>) {
    for (const auto& __element : __value)
      __define_static::__append_leaves(__values, __element);
  } else {
    (void)meta::reflect_constant(static_cast<_Leaf>(__value));
    // One conversion per element, as in the draft's static_cast<T>(*it).
    __values.emplace_back(__value);
  }
