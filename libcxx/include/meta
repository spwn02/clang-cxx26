namespace __define_static {
// Validate before the internal builder: invalid template arguments must throw
// meta::exception, including pointer members of structural class leaves.
template <class Leaf, class T>
consteval void __append_leaves(vector<Leaf>& values, const T& value) {
  if constexpr (is_array_v<T>) {
    for (const auto& element : value)
      __append_leaves(values, element);
  } else {
    (void)reflect_constant(static_cast<Leaf>(value));
    // One conversion per element, as in the draft's static_cast<T>(*it).
    values.emplace_back(value);
  }
}
} // namespace __define_static

template <ranges::input_range R>
consteval auto reflect_constant_array(R &&elems) -> info {
  using ValTy = ranges::range_value_t<R>;
  using LeafTy = remove_all_extents_t<ValTy>;
  static_assert(__reflect_constant_array_structural_v<ValTy>,
                "reflect_constant_array requires a structural element type");
  static_assert(is_array_v<ValTy> ? __reflect_constant_array_row_ok_v<ValTy>
                                 : is_constructible_v<ValTy, ranges::range_reference_t<R>>,
                "reflect_constant_array requires the element type to be constructible from the range reference type");
  vector<LeafTy> values;
  // Avoid reallocation, which would copy (and be observable for) class elements.
  if constexpr (ranges::sized_range<R> && !is_array_v<ValTy>)
    values.reserve(static_cast<size_t>(ranges::size(elems)));
  size_t count = 0;
  for (auto&& value : elems) {
    ++count;
    if constexpr (is_array_v<ValTy>) {
      __define_static::__append_leaves(values, value);
    } else {
      // LWG 4432: convert range proxies to the actual element type.
      (void)reflect_constant(static_cast<ValTy>(value));
      values.emplace_back(value);
    }
  }
  if (count == 0)
    return reflect_constant(std::array<LeafTy, 0>{});
  vector<size_t> dims = {count};
  [&]<size_t... Is>(index_sequence<Is...>) {
    (dims.push_back(extent_v<ValTy, Is>), ...);
  }(make_index_sequence<rank_v<ValTy>>());
  if constexpr (is_same_v<LeafTy, bool>) {
    // vector<bool> has no contiguous data buffer.
    allocator<bool> alloc;
    bool* data = alloc.allocate(values.size());
    for (size_t i = 0; i != values.size(); ++i)
      construct_at(data + i, static_cast<bool>(values[i]));
    info result = __reflect_array_object(dims.data(), dims.size(), data, values.size());
    alloc.deallocate(data, values.size());
    return result;
  } else {
    return __reflect_array_object(dims.data(), dims.size(), values.data(), values.size());
  }
}

template <ranges::input_range R>
consteval auto reflect_constant_string(R &&r) -> info {
  using CharT = ranges::range_value_t<R>;
  static_assert(same_as<CharT, char> || same_as<CharT, wchar_t> ||
                same_as<CharT, char8_t> || same_as<CharT, char16_t> ||
                same_as<CharT, char32_t>);

  vector<CharT> values;
  for (auto&& c : r)
    values.push_back(static_cast<CharT>(c));
  bool literal = false;
  if constexpr (requires { std::is_string_literal(r); })
    literal = std::is_string_literal(r);
  if (literal)
    values.pop_back();
  values.push_back(CharT{});
  size_t size = values.size();
  return __reflect_array_object(&size, 1, values.data(), size);
}

template <class CharT>
consteval bool __is_string_literal(const CharT *p) {
  return __metafunction(detail::__metafn_is_string_literal, p);
}

