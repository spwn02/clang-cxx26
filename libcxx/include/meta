namespace __define_static {
// An unknown reference may be used in a constant expression when size() does
// not read the object (e.g. arrays, std::array, and fixed-extent spans). Keep
// the parameter unevaluated at the call site; declval itself is not constexpr.
template <class R>
auto __static_array_extent(R &r) -> integral_constant<size_t, static_cast<size_t>(ranges::size(r))>;
auto __static_array_extent(...) -> integral_constant<size_t, dynamic_extent>;
template <class R>
inline constexpr size_t __static_array_extent_v = decltype(__static_array_extent(declval<R &>()))::value;
} // namespace __define_static

template <ranges::input_range R>
consteval auto define_static_array(R &&elems)
    -> span<const ranges::range_value_t<R>, __define_static::__static_array_extent_v<R>> {
  // P3491R3: these are Mandates, i.e. ill-formed at the call, not a constraint that removes the overload.
  static_assert(meta::__reflect_constant_array_structural_v<ranges::range_value_t<R>>,
                "define_static_array requires a structural element type");
  static_assert(is_array_v<ranges::range_value_t<R>>
                    ? meta::__reflect_constant_array_row_ok_v<ranges::range_value_t<R>>
                    : is_constructible_v<ranges::range_value_t<R>, ranges::range_reference_t<R>>,
                "define_static_array requires the element type to be constructible from the range reference type");
  using ValTy  = ranges::range_value_t<R>;
  using Result = span<const ValTy, __define_static::__static_array_extent_v<R>>;
  meta::info array = meta::reflect_constant_array(elems);
  if (meta::is_array_type(meta::type_of(array))) {
    return Result(extract<const ValTy*>(array), meta::extent(type_of(array)));
  } else {
    return Result(static_cast<const ValTy*>(nullptr), 0);
  }
}

template <ranges::input_range R>
consteval auto define_static_string(R &&r) -> const ranges::range_value_t<R> * {
  using CharT = ranges::range_value_t<R>;
  return extract<const CharT *>(meta::reflect_constant_string(r));
}

template <class T>
consteval auto define_static_object(T &&t) -> const remove_cvref_t<T> * {
  using U = remove_cvref_t<T>;
  if constexpr (is_class_v<U> || is_union_v<U>)
    return addressof(extract<const U &>(meta::reflect_constant(std::forward<T>(t))));
  else if constexpr (is_array_v<U>)
    return addressof(extract<const U &>(meta::reflect_constant_array(std::forward<T>(t))));
  else
    return define_static_array(span(addressof(t), 1)).data();
}

