// [meta.reflection.access.context]: a structural, non-aggregate struct. The data
// members are public (structural) but non-const so the type is assignable.
struct access_context {
private:
  consteval access_context(info __scope, info __designating_class) noexcept
      : __d_scope{__scope}, __d_designating_class{__designating_class} { }

public:
  info __d_scope;
  info __d_designating_class;

  consteval access_context() = delete;

  consteval info scope() const { return __d_scope; }
  consteval info designating_class() const { return __d_designating_class; }

  [[_Clang::__instantiation_dependent__]]
  static consteval access_context current() noexcept {
    return {__metafunction(__detail::__metafn_access_context), {}};
  }

  static consteval access_context unprivileged() noexcept {
    return access_context{^^::, info{}};
  }

  static consteval access_context unchecked() noexcept {
    return access_context{info{}, info{}};
  }

  consteval access_context via(info __new_designating_class) const {
    // [meta.reflection.access.context]: throws unless the argument is the null
    // reflection or a reflection of a complete class type.
    if (__new_designating_class != info{} &&
        (!is_class_type(__new_designating_class) ||
         !is_complete_type(__new_designating_class)))
      throw __lib_exception(u8"access_context::via requires a null reflection or complete class type", ^^access_context::via, source_location::current(__builtin_meta_call_origin()));

    return access_context{__d_scope, __new_designating_class};
  }
};

// Scope identification (P3795R2).
[[_Clang::__instantiation_dependent__]]
consteval info current_function() {
  info __scope = __metafunction(__detail::__metafn_current_function);
  if (!is_function(__scope))
    throw __lib_exception(u8"current scope does not represent a function",
                    ^^current_function,
                    source_location::current(__builtin_meta_call_origin()));
  return __scope;
}

[[_Clang::__instantiation_dependent__]]
consteval info current_class() try {
  info __scope = __metafunction(__detail::__metafn_current_class);
  if (is_function(__scope))
    __scope = parent_of(__scope);
  if (!is_class_type(__scope))
    throw __lib_exception(u8"current scope does not represent a class nor a member function",
                    ^^current_class,
                    source_location::current(__builtin_meta_call_origin()));
  return __scope;
} catch (exception& __e) {
  __set_exception_from(__e, current_function());
  throw;
}

[[_Clang::__instantiation_dependent__]]
consteval info current_namespace() {
  info __scope = __metafunction(__detail::__metafn_current_namespace);
  while (!is_namespace(__scope))
    __scope = parent_of(__scope);
  return __scope;
}

