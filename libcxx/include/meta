// Returns a reflection representing a description of a data member, which may
// be used with 'define_aggregate' to define a record type.
consteval auto data_member_spec(info member_type,
                                data_member_options options = {}) -> info {
  if (!is_type(member_type))
    throw exception(u8"member type must represent an object or reference type", ^^data_member_spec);
  member_type = detail::__underlying_entity_of(member_type);
  if (!is_object_type(member_type) && !is_reference_type(member_type))
    throw exception(u8"member type must represent an object or reference type", ^^data_member_spec);

  bool has_name = options.name.has_value();
  int alignment = options.alignment.value_or(0);
  int width = options.bit_width.value_or(0);
  bool no_unique_address = options.no_unique_address;
  if (!has_name && (!options.bit_width.has_value() || !options.annotations.empty()))
    throw exception(u8"unnamed member must be a bit-field without annotations", ^^data_member_spec);
  for (info& annotation : options.annotations) {
    // Annotation failures belong to data_member_spec, including failures in
    // type_of and constant_of. Store the value required by the description.
    info type = __metafunction(detail::__metafn_type_of, annotation, ^^data_member_spec);
    if (!is_object_type(type) || is_array_type(type))
      throw exception(u8"annotation must have non-array object type", ^^data_member_spec);
    annotation = __metafunction(detail::__metafn_constant_of, annotation, ^^data_member_spec);
  }

  if (options.bit_width.has_value()) {
    if (!is_integral_type(member_type) && !is_enum_type(member_type))
      throw exception(u8"bit-field must have integral or enumeration type", ^^data_member_spec);
    if (options.alignment.has_value())
      throw exception(u8"cannot specify both bit width and alignment", ^^data_member_spec);
    if (no_unique_address)
      throw exception(u8"cannot specify both bit width and no_unique_address", ^^data_member_spec);
    if (width < 0)
      throw exception(u8"bit width must not be negative", ^^data_member_spec);
    if (width == 0 && has_name)
      throw exception(u8"zero-width bit-field must be unnamed", ^^data_member_spec);
    if (!has_name && (is_const(member_type) || is_volatile(member_type)))
      throw exception(u8"unnamed bit-field must not be cv-qualified", ^^data_member_spec);
  }

  if (options.alignment.has_value()) {
    if (alignment <= 0 || ((alignment - 1) & alignment))
      throw exception(u8"alignment must be a positive power of two", ^^data_member_spec);
    if (!is_complete_type(member_type))
      throw exception(u8"alignment requires a complete member type", ^^data_member_spec);
    if (alignment < int(alignment_of(member_type)))
      throw exception(u8"alignment must not be less than that of the member type", ^^data_member_spec);
  }

  if (has_name) {
    if (options.name->is_u8) {
      const u8string &s = options.name->u8;
      return __metafunction(detail::__metafn_data_member_spec,
                            member_type,
                            true, s.size(), ^^const char8_t, s.data(),
                            options.alignment.has_value(), alignment,
                            options.bit_width.has_value(), width,
                            no_unique_address,
                            options.annotations.size(), options.annotations.data(),
#if __has_feature(attribute_reflection)
                            options.attributes.size(), options.attributes.data(),
#else
                            size_t(0), (const info *)nullptr,
#endif
                            ^^data_member_spec);
    } else {
      const string &s = options.name->s;
      return __metafunction(detail::__metafn_data_member_spec,
                            member_type,
                            true, s.size(), ^^const char, s.data(),
                            options.alignment.has_value(), alignment,
                            options.bit_width.has_value(), width,
                            no_unique_address,
                            options.annotations.size(), options.annotations.data(),
#if __has_feature(attribute_reflection)
                            options.attributes.size(), options.attributes.data(),
#else
                            size_t(0), (const info *)nullptr,
#endif
                            ^^data_member_spec);
    }
  } else {
    return __metafunction(detail::__metafn_data_member_spec,
      member_type,
      false, 0, ^^const char, "",
      options.alignment.has_value(), alignment,
      options.bit_width.has_value(), width,
      no_unique_address,
      options.annotations.size(), options.annotations.data(),
#if __has_feature(attribute_reflection)
      options.attributes.size(), options.attributes.data(),
#else
      size_t(0), (const info *)nullptr,
#endif
      ^^data_member_spec);
  }
}

// Completes the definition of the record type reflected by 'class_type' with
// the members described by the reflections in the provided range.
template <reflection_range R = initializer_list<info>>
consteval auto define_aggregate(info class_type, R &&members) -> info {
  if constexpr (ranges::contiguous_range<R>) {
    return __metafunction(detail::__metafn_define_aggregate, class_type,
                          ranges::size(members), ranges::data(members));
  } else {
    vector vmembers(from_range, members);
    return __metafunction(detail::__metafn_define_aggregate, class_type,
                          vmembers.size(), vmembers.data());
  }
}

