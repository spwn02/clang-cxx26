template <ranges::input_range _Rp>
consteval auto reflect_constant_array(_Rp &&__elems) -> info try {
  using _ValTy = ranges::range_value_t<_Rp>;
  using _LeafTy = remove_all_extents_t<_ValTy>;
  static_assert(__reflect_constant_array_structural_v<_ValTy>,
                "reflect_constant_array requires a structural element type");
  static_assert(is_array_v<_ValTy> ? __reflect_constant_array_row_ok_v<_ValTy>
                                 : is_constructible_v<_ValTy, ranges::range_reference_t<_Rp>>,
                "reflect_constant_array requires the element type to be constructible from the range reference type");
  vector<_LeafTy> __values;
  // Avoid reallocation, which would copy (and be observable for) class elements.
  if constexpr (ranges::sized_range<_Rp> && !is_array_v<_ValTy>)
    __values.reserve(static_cast<size_t>(ranges::size(__elems)));
  size_t __count = 0;
  for (auto&& __value : __elems) {
    ++__count;
    if constexpr (is_array_v<_ValTy>) {
      __define_static::__append_leaves(__values, __value);
    } else {
      // LWG 4432: convert range proxies to the actual element type.
      (void)meta::reflect_constant(static_cast<_ValTy>(__value));
      __values.emplace_back(__value);
    }
  }
  if (__count == 0)
    return meta::reflect_constant(std::array<_LeafTy, 0>{});
  vector<size_t> __dims = {__count};
  [&]<size_t... _Is>(index_sequence<_Is...>) {
    (__dims.push_back(extent_v<_ValTy, _Is>), ...);
  }(make_index_sequence<rank_v<_ValTy>>());
  if constexpr (is_same_v<_LeafTy, bool>) {
    // vector<bool> has no contiguous data buffer.
    allocator<bool> __alloc;
    bool* __data = __alloc.allocate(__values.size());
    for (size_t __i = 0; __i != __values.size(); ++__i)
      construct_at(__data + __i, static_cast<bool>(__values[__i]));
    info __result = meta::__reflect_array_object(__dims.data(), __dims.size(), __data,
                                        __values.size(), current_function());
    __alloc.deallocate(__data, __values.size());
    return __result;
  } else {
    return meta::__reflect_array_object(__dims.data(), __dims.size(), __values.data(),
                                  __values.size(), current_function());
  }
} catch (exception& __e) {
  __set_exception_from(__e, current_function());
  throw;
}

template <ranges::input_range _Rp>
consteval auto reflect_constant_string(_Rp &&__r) -> info try {
  using _CharT = ranges::range_value_t<_Rp>;
  static_assert(same_as<_CharT, char> || same_as<_CharT, wchar_t> ||
                same_as<_CharT, char8_t> || same_as<_CharT, char16_t> ||
                same_as<_CharT, char32_t>);

  bool __literal = false;
  if constexpr (requires { std::is_string_literal(__r); })
    __literal = std::is_string_literal(__r);
  if constexpr (ranges::sized_range<_Rp> && ranges::contiguous_range<_Rp>) {
    size_t __count = static_cast<size_t>(ranges::size(__r));
    if (__literal)
      --__count;
    size_t __size = __count + 1;
    if (__literal) {
      return meta::__reflect_array_object(&__size, 1, ranges::data(__r), __size,
                                    current_function());
    }
    // One exact-size allocation and a single bulk copy: much cheaper in
    // constant evaluation than growing a vector one character at a time.
    allocator<_CharT> __alloc;
    _CharT* __values = __alloc.allocate(__size);
    try {
      std::uninitialized_copy_n(ranges::data(__r), __count, __values);
      std::construct_at(__values + __count);
      info __result = meta::__reflect_array_object(&__size, 1, __values, __size, current_function());
      __alloc.deallocate(__values, __size);
      return __result;
    } catch (...) {
      __alloc.deallocate(__values, __size);
      throw;
    }
  } else {
    vector<_CharT> __values;
    for (auto&& __c : __r)
      __values.push_back(static_cast<_CharT>(__c));
    if (__literal)
      __values.pop_back();
    __values.push_back(_CharT{});
    size_t __size = __values.size();
    return meta::__reflect_array_object(&__size, 1, __values.data(), __size, current_function());
  }
} catch (exception& __e) {
  __set_exception_from(__e, current_function());
  throw;
