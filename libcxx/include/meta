_LIBCPP_CLANG_DIAGNOSTIC_IGNORED("-Wweak-vtables")
class exception : public std::exception {
  optional<string> __what_;
  u8string __u8what_;
  info __from_;
  source_location __where_;
  // Set only for exceptions the library itself originates. User-constructed
  // exceptions that propagate through a metafunction are never rewritten.
  bool __library_ = false;

  // Attribute both observers to the public metafunction without replacing
  // the active exception or its diagnostic message when a delegate throws.
  friend consteval void __set_exception_from(exception& __e, info __from) {
    if (!__e.__library_)
      return;
    __e.__from_ = __from;
    __e.__where_ = source_location::current(__builtin_meta_call_origin());
  }
  friend consteval exception __lib_exception(u8string_view, info, source_location);
  friend consteval exception __lib_exception(string_view, info, source_location);

public:
  consteval exception(u8string_view __what, info __from,
                      source_location __where = source_location::current()) noexcept
      : __what_(string(__what.begin(), __what.end())),
        __u8what_(__what),
        __from_(__from),
        __where_(__where) {}

  consteval exception(string_view __what, info __from,
                      source_location __where = source_location::current()) noexcept
      : __what_(__what),
        __u8what_(u8string(__what.begin(), __what.end())),
        __from_(__from),
        __where_(__where) {}

  _LIBCPP_HIDE_FROM_ABI exception(const exception&) = default;
  _LIBCPP_HIDE_FROM_ABI exception(exception&&) = default;
  _LIBCPP_HIDE_FROM_ABI exception& operator=(const exception&) = default;
  _LIBCPP_HIDE_FROM_ABI exception& operator=(exception&&) = default;

  _LIBCPP_HIDE_FROM_ABI_VIRTUAL constexpr const char* what() const noexcept override { return __what_->c_str(); }
  consteval u8string_view u8what() const noexcept { return __u8what_; }
  consteval info from() const noexcept { return __from_; }
  consteval source_location where() const noexcept { return __where_; }
};
_LIBCPP_DIAGNOSTIC_POP

consteval exception __lib_exception(u8string_view __what, info __from, source_location __where) {
  exception __e(__what, __from, __where);
  __e.__library_ = true;
  return __e;
}

consteval exception __lib_exception(string_view __what, info __from, source_location __where) {
  exception __e(__what, __from, __where);
  __e.__library_ = true;
  return __e;
}

// Compiler entry point for P3560R2 failures that originate inside a
// metafunction rather than in library code.  Keeping construction here gives
// the constant evaluator an ordinary, fully type-checked call expression to
// evaluate; in particular, it must not synthesize a constructor AST by hand.
_LIBCPP_HIDE_FROM_ABI consteval info __make_exception(info __from, const char* __what) {
  throw __lib_exception(string_view(__what), __from, source_location::current(__builtin_meta_call_origin()));
}

