consteval auto static_data_members_of(info r,
                                      access_context ctx) -> vector<info> {
  if (is_namespace(r))
    throw exception(u8"Namespaces cannot have static data members",
                    ^^static_data_members_of);

  return __filtered(__members_of(r, ctx, ^^static_data_members_of),
                    is_variable);
}

consteval auto nonstatic_data_members_of(info r,
                                         access_context ctx) -> vector<info> {
  if (is_namespace(r))
    throw exception(u8"Namespaces cannot have non-static data members",
                    ^^nonstatic_data_members_of);

  return __filtered(__members_of(r, ctx, ^^nonstatic_data_members_of),
                    is_nonstatic_data_member);
}

consteval auto subobjects_of(info r, access_context ctx) -> vector<info> {
  if (!is_class_type(r))
    throw exception(u8"bad class", ^^subobjects_of);
  vector<info> result = bases_of(r, ctx);
  for (info subobject : nonstatic_data_members_of(r, ctx))
    result.push_back(subobject);
  return result;
}

