struct member_offset {
  ptrdiff_t bytes;
  ptrdiff_t bits;

  constexpr auto total_bits() const -> ptrdiff_t {
    return bytes * CHAR_BIT + bits;
  }

  auto operator<=>(member_offset const&) const = default;
};

// Returns the offset of the reflected entity.
consteval auto offset_of(info r) -> member_offset {
  if (!is_nonstatic_data_member(r) && !is_base(r))
    throw exception(u8"bad member", ^^offset_of);
  if (is_base(r) && is_virtual(r) &&
      extract<bool>(substitute(^^is_abstract_v, {parent_of(r)})))
    throw exception(u8"virtual base of an abstract class", ^^offset_of);
  return member_offset {
      __metafunction(detail::__metafn_offset_of, ^^ptrdiff_t, r),
      __metafunction(detail::__metafn_bit_offset_of, ^^ptrdiff_t, r)
  };
}

consteval auto __is_size_operand(info r, bool allow_bit_field) -> bool {
  if (is_type(r))
    return is_complete_type(r);
  if (is_object(r) || is_value(r) || is_base(r) || is_data_member_spec(r))
    return true;
  if (is_bit_field(r))
    return allow_bit_field;
  if (is_variable(r))
    return !extract<bool>(substitute(^^is_reference_v, {type_of(r)}));
  return is_nonstatic_data_member(r) &&
         (allow_bit_field || !is_bit_field(r));
}

// Returns the size of the reflected entity.
consteval auto size_of(info r) -> size_t {
  if (!__is_size_operand(r, false))
    throw exception(u8"bad", ^^size_of);
  return __metafunction(detail::__metafn_size_of, r);
}

// Returns the size of the reflected entity in bits.
consteval auto bit_size_of(info r) -> size_t {
  if (!__is_size_operand(r, true))
    throw exception(u8"bad", ^^bit_size_of);
  return __metafunction(detail::__metafn_bit_size_of, r);
}

consteval auto alignment_of(info r) -> size_t {
  if (is_type(r)) {
    if (!is_complete_type(r))
      throw exception(u8"bad", ^^alignment_of);
  } else if (is_object(r) || is_base(r) || is_data_member_spec(r)) {
    // valid
  } else if (is_variable(r)) {
    if (extract<bool>(substitute(^^is_reference_v, {type_of(r)})))
      throw exception(u8"bad reference", ^^alignment_of);
  } else if (!is_nonstatic_data_member(r) || is_bit_field(r)) {
    throw exception(u8"bad", ^^alignment_of);
  }
  return __metafunction(detail::__metafn_alignment_of, r);
}

