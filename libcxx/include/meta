template<typename T>
consteval optional<T> annotation_of_type(info r) {
  auto v = annotations_of(r, ^^T);
  optional<T> result{};
  for (info a: v) {
    if (result.has_value()) {
      if (extract<T>(a) != result) {
        throw "inconsistent annotations";
      }
    } else {
      result = extract<T>(a);
    }
  }
  return result;
}

