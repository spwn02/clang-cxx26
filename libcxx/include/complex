  // (a power of 2) is exact in binary floating point, so this loses no precision itself.
  _Tp __m = __x;
  int __k = 0;
  while (__m >= _Tp(4)) {
    __m /= 4;
    ++__k;
  }
  while (__m < _Tp(1)) {
    __m *= 4;
    --__k;
  }
  // Newton-Raphson: y_{n+1} = (y_n + m/y_n) / 2, quadratically convergent once y_0 is within a
  // factor of 2 of the true root, which (m+1)/2 always is for m in [1, 4).
  _Tp __y = (__m + 1) / 2;
  for (int __i = 0; __i < 64; ++__i) {
    _Tp __y_next = (__y + __m / __y) / 2;
    if (__y_next == __y)
      break;
    __y = __y_next;
