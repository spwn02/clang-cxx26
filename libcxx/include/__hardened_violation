#ifndef _LIBCPP___HARDENED_VIOLATION
#define _LIBCPP___HARDENED_VIOLATION

#include <__config>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

#if _LIBCPP_STD_VER >= 26

_LIBCPP_BEGIN_NAMESPACE_STD

// [intro.compliance.general]: violating a hardened precondition of a hardened implementation results in a contract
// violation, evaluated with a terminating semantic. This function is only called by the assertion handler (the
// `enforce` assertion semantic): it forms a contract violation (kind `pre`, detection mode `predicate_false`, semantic
// `enforce`, the location being the assertion's), runs the contract-violation handler ([basic.contract.handler]) and then terminates the program.
[[__noreturn__, __gnu__::__cold__]] _LIBCPP_EXPORTED_FROM_ABI void
__handle_hardened_violation(const char* __message, const char* __file, const char* __function, unsigned __line);

_LIBCPP_END_NAMESPACE_STD

#endif // _LIBCPP_STD_VER >= 26

#endif // _LIBCPP___HARDENED_VIOLATION
