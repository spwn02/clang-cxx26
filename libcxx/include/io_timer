#ifndef _LIBCPP_IO_TIMER
#define _LIBCPP_IO_TIMER

/*
    io_timer synopsis

    Stage Two of the networking series (platform I/O). Experimental: the header is available in C++29 mode with
    -fexperimental-library only, on a platform that has a backend (Linux: epoll), and needs thread support; otherwise it
    is empty. Provisional specification: P4100R1 [8.8] and the Corosio library (no WG21 paper yet).

namespace std::io {
  class timer {
  public:
    using clock_type = chrono::steady_clock;
    using time_point = clock_type::time_point;
    using duration   = clock_type::duration;

    explicit timer(execution_context&);
    timer(execution_context&, time_point);
    timer(execution_context&, duration);
    template<Executor Ex> explicit timer(const Ex&);            // and with a time_point or a duration
    ~timer();                                                   // cancels the waits

    time_point expiry() const noexcept;
    size_t expires_at(time_point) noexcept;                     // returns the number of cancelled waits
    size_t expires_after(duration) noexcept;
    size_t cancel() noexcept;
    size_t cancel_one() noexcept;
    IoAwaitable-of-io_result<> wait() noexcept;
  };
}
*/

#if __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
#  include <__cxx03/__config>
#else
#  include <__config>

#  if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#    pragma GCC system_header
#  endif

#  include <version>

#  include <__io/support/config.h>

#  if _LIBCPP_HAS_IO_EPOLL

#    include <__io_timer/timer.h>

#  endif // _LIBCPP_HAS_IO_EPOLL

#endif // __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)

#endif // _LIBCPP_IO_TIMER
