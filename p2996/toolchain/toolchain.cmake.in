# Generated as part of an immutable clang-p2996 reference-toolchain snapshot.
# This file is relocatable with the snapshot directory.

cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH _p2996_share_dir)
cmake_path(GET _p2996_share_dir PARENT_PATH _p2996_root)
cmake_path(NORMAL_PATH _p2996_root)

set(CMAKE_C_COMPILER
    "${_p2996_root}/bin/clang"
    CACHE FILEPATH "clang-p2996 C compiler")
set(CMAKE_CXX_COMPILER
    "${_p2996_root}/bin/clang++"
    CACHE FILEPATH "clang-p2996 C++ compiler")

if(EXISTS "${_p2996_root}/bin/llvm-ar")
  set(CMAKE_AR
      "${_p2996_root}/bin/llvm-ar"
      CACHE FILEPATH "clang-p2996 archiver")
endif()

if(EXISTS "${_p2996_root}/bin/llvm-ranlib")
  set(CMAKE_RANLIB
      "${_p2996_root}/bin/llvm-ranlib"
      CACHE FILEPATH "clang-p2996 ranlib")
endif()

# A reference snapshot models the fork's complete C++26 mode. Keep the
# language mode explicit at the toolchain boundary so CMake's synthetic
# standard-library module target is compiled with the same mode as consumers.
# Linux Clang otherwise defaults to libstdc++, and the current p2996 fork still
# gates the complete reflection implementation behind -freflection-latest.
#
# CMake may evaluate a toolchain file more than once while enabling languages.
# Append each flag only when it is not already present so repeated evaluation
# cannot duplicate the reference-mode command line.
foreach(_p2996_cxx_flag IN ITEMS -std=c++26 -stdlib=libc++ -freflection-latest)
  string(FIND " ${CMAKE_CXX_FLAGS_INIT} " " ${_p2996_cxx_flag} "
              _p2996_flag_index)
  if(_p2996_flag_index EQUAL -1)
    string(APPEND CMAKE_CXX_FLAGS_INIT " ${_p2996_cxx_flag}")
  endif()
endforeach()

foreach(_p2996_linker_flags_var IN ITEMS CMAKE_EXE_LINKER_FLAGS_INIT
                                          CMAKE_SHARED_LINKER_FLAGS_INIT
                                          CMAKE_MODULE_LINKER_FLAGS_INIT)
  string(FIND " ${${_p2996_linker_flags_var}} " " -fuse-ld=lld "
              _p2996_flag_index)
  if(_p2996_flag_index EQUAL -1)
    string(APPEND ${_p2996_linker_flags_var} " -fuse-ld=lld")
  endif()
endforeach()

set(CMAKE_BUILD_RPATH "@P2996_BUILD_RPATH@")

# CMake 4.4 still requires the experimental import-std gate to be enabled before
# C++ language discovery. A project may also set this itself.
if(CMAKE_VERSION VERSION_LESS 4.5 AND NOT DEFINED
                                      CMAKE_EXPERIMENTAL_CXX_IMPORT_STD)
  set(CMAKE_EXPERIMENTAL_CXX_IMPORT_STD
      "f35a9ac6-8463-4d38-8eec-5d6008153e7d"
      CACHE STRING "CMake 4.4 import-std experimental gate")
endif()

unset(_p2996_flag_index)
unset(_p2996_linker_flags_var)
unset(_p2996_cxx_flag)
unset(_p2996_share_dir)
unset(_p2996_root)
