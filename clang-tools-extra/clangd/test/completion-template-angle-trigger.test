# RUN: clangd -lit-test < %s | FileCheck -strict-whitespace %s
# Typing the `<` that opens a template argument list is an auto-trigger for
# completion and must return candidates right away (`TParam` is the enclosing
# template parameter). A `<` that is not one (`a <`) is ignored, but the empty
# result has to be marked incomplete so the client asks again on the next
# keystroke instead of caching the empty list.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"processId":123,"rootPath":"clangd","capabilities":{},"trace":"off"}}
---
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"test:///main.cpp","languageId":"cpp","version":1,"text":"template <class TParam> struct Box {};\ntemplate <class TParam> void f() {\n  Box<\n}\nint g(int a, int b) {\n  return a <\n}\n"}}}
---
{"jsonrpc":"2.0","id":1,"method":"textDocument/completion","params":{"textDocument":{"uri":"test:///main.cpp"},"position":{"line":2,"character":6},"context":{"triggerKind":2,"triggerCharacter":"<"}}}
#      CHECK:  "id": 1,
# CHECK-NEXT:  "jsonrpc": "2.0",
# CHECK-NEXT:  "result": {
# CHECK-NEXT:    "isIncomplete": false,
# CHECK-NEXT:    "items": [
#      CHECK:        "label": "{{.*}}TParam{{.*}}"
---
{"jsonrpc":"2.0","id":2,"method":"textDocument/completion","params":{"textDocument":{"uri":"test:///main.cpp"},"position":{"line":5,"character":11},"context":{"triggerKind":2,"triggerCharacter":"<"}}}
#      CHECK:  "id": 2,
# CHECK-NEXT:  "jsonrpc": "2.0",
# CHECK-NEXT:  "result": {
# CHECK-NEXT:    "isIncomplete": true,
# CHECK-NEXT:    "items": []
# CHECK-NEXT:  }
---
{"jsonrpc":"2.0","id":3,"method":"shutdown"}
---
{"jsonrpc":"2.0","method":"exit"}
